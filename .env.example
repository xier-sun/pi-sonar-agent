# SonarQube Configuration
SONARQUBE_HOST=http://localhost:9000
SONARQUBE_TOKEN=your_sonar_token_here
SONARQUBE_ORG=your_organization

# Azure DevOps Configuration
ADO_BASE_URL=https://devops.yourcompany.com/DefaultCollection
ADO_PROJECT=your_project
ADO_PAT=your_pat_token
# (Optional) Auto-complete the created PR after required policies pass.
# ADO_PR_AUTO_COMPLETE_ENABLED=true
# (Optional) Delete the fix branch automatically when the PR completes.
# ADO_PR_DELETE_SOURCE_BRANCH_ON_COMPLETE=true
# (Optional) Override the identity used to set auto-complete. When omitted,
# the agent falls back to the PR creator identity returned by Azure DevOps.
# ADO_PR_AUTO_COMPLETE_IDENTITY_ID=

# Runtime target defaults (so `python run.py` can run without CLI args)
PROJECT_KEY=your_sonar_project_key
REPOSITORY=your_ado_repository
AUTHOR=your@email.com

# (Optional) Anthropic API Key - uses Claude Code CLI by default
# ANTHROPIC_API_KEY=sk-ant-...

# (Optional) OpenAI API - for custom LLM fallback
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# (Optional) Explicit model selection. If omitted, the SDK default is used.
# CLAUDE_MODEL=sonnet
# OPENAI_MODEL=sonnet

# (Optional) Two-tier model ladder.
# Tier1 is the default model for every issue in the first pass.
# Tier2 is the fallback model for same-issue failover, and the default model
# for the author-level second pass over unresolved issues.
# When Tier1/Tier2 are not set, the legacy flat model settings above remain valid.
# PI_SONAR_MODEL_TIER1_ANTHROPIC_MODEL=claude-sonnet-4-6
# PI_SONAR_MODEL_TIER1_ANTHROPIC_API_KEY=sk-ant-tier1
# PI_SONAR_MODEL_TIER1_ANTHROPIC_BASE_URL=https://api.anthropic.com
# PI_SONAR_MODEL_TIER2_ANTHROPIC_MODEL=claude-opus-4-1
# PI_SONAR_MODEL_TIER2_ANTHROPIC_API_KEY=sk-ant-tier2
# PI_SONAR_MODEL_TIER2_ANTHROPIC_BASE_URL=https://api.anthropic.com
# PI_SONAR_SECOND_PASS_ENABLED=true
# PI_SONAR_ABORT_PUBLISH_ENABLED=true

# (Optional) For third-party gateway model IDs such as `glm-4.7`, the agent
# will auto-register the configured model as a Claude Code custom option.
# You can override the display name/description if desired:
# ANTHROPIC_CUSTOM_MODEL_OPTION_NAME=GLM 4.7
# ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION=Gateway custom model

# Build Configuration
BUILD_COMMAND=dotnet build
TEST_COMMAND=dotnet test
SOLUTION_PATH=

# Agent Configuration
MAX_TURNS=10
MAX_BUDGET_USD=5.0

# Workspace
WORKSPACE_ROOT=.agent_workspaces
KEEP_WORKSPACE=false

# DingTalk notification / stream
# DINGTALK_APPKEY=
# DINGTALK_APPSECRET=
# DINGTALK_AGENTID=
# DINGTALK_WEBHOOK=
# DINGTALK_SECRET=
# (Optional) Stream mode credentials. When omitted, the stream service
# falls back to DINGTALK_APPKEY / DINGTALK_APPSECRET.
# DINGTALK_STREAM_CLIENT_ID=
# DINGTALK_STREAM_CLIENT_SECRET=
# (Optional) Retry delay in seconds after the stream connection drops.
# DINGTALK_STREAM_RECONNECT_DELAY_SECONDS=5
# (Optional) Confirmation card template id for clickable STREAM callbacks.
# When omitted, the bot falls back to plain-text confirmation instructions
# (`确认任务 <job_id>` / `取消任务 <job_id>`) and will not send a clickable card.
# DINGTALK_CONFIRMATION_CARD_TEMPLATE_ID=

# Logging
LOG_LEVEL=INFO

# MySQL / ERP4
# Used to resolve DingTalk UserId from Sonar author email when
# `data/targets.json` does not provide `dingtalk_userid`.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=erp4

# DingTalk manual-trigger guardrails
# Comma-separated staff IDs allowed to create fix jobs. Leave empty to allow all.
# DINGTALK_ALLOWED_STAFF_IDS=
# Comma-separated staff IDs allowed to cancel jobs created by others.
# DINGTALK_ADMIN_STAFF_IDS=
# Comma-separated conversation IDs allowed to trigger jobs. Leave empty to allow all.
# DINGTALK_ALLOWED_CONVERSATION_IDS=
# Maximum active jobs (awaiting_confirmation/queued/running) per trigger user.
# Set 0 or omit to disable.
# DINGTALK_TRIGGER_MAX_ACTIVE_JOBS_PER_USER=2
# Maximum accepted fix jobs per user within the configured time window.
# Set 0 or omit to disable.
# DINGTALK_TRIGGER_MAX_JOBS_PER_WINDOW=3
# Sliding window size in seconds for trigger rate limiting.
# DINGTALK_TRIGGER_WINDOW_SECONDS=600
