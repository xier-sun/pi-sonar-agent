# SonarQube Configuration
SONARQUBE_HOST=http://localhost:9000
SONARQUBE_TOKEN=your_sonar_token_here
SONARQUBE_ORG=your_organization

# Azure DevOps Configuration
ADO_BASE_URL=https://devops.yourcompany.com/DefaultCollection
ADO_PROJECT=your_project
ADO_PAT=your_pat_token

# Runtime target defaults (so `python run.py` can run without CLI args)
PROJECT_KEY=your_sonar_project_key
REPOSITORY=your_ado_repository
AUTHOR=your@email.com

# (Optional) Anthropic API Key - uses Claude Code CLI by default
# ANTHROPIC_API_KEY=sk-ant-...

# (Optional) OpenAI API - for custom LLM fallback
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# (Optional) Explicit model selection. If omitted, the SDK default is used.
# CLAUDE_MODEL=sonnet
# OPENAI_MODEL=sonnet

# (Optional) For third-party gateway model IDs such as `glm-4.7`, the agent
# will auto-register the configured model as a Claude Code custom option.
# You can override the display name/description if desired:
# ANTHROPIC_CUSTOM_MODEL_OPTION_NAME=GLM 4.7
# ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION=Gateway custom model

# Build Configuration
BUILD_COMMAND=dotnet build
TEST_COMMAND=dotnet test
SOLUTION_PATH=

# Agent Configuration
MAX_TURNS=10
MAX_BUDGET_USD=5.0

# Workspace
WORKSPACE_ROOT=.agent_workspaces
KEEP_WORKSPACE=false

# Logging
LOG_LEVEL=INFO

# MySQL / ERP4
# Used to resolve DingTalk UserId from Sonar author email when
# `data/targets.json` does not provide `dingtalk_userid`.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=erp4
