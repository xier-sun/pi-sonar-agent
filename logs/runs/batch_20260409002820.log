2421 |         private static (decimal,decimal) CalculatePenaltyAmount( HistoricalOverdueCalculationService.OverDueAmountAndDays overdueInfo,  SaleOrderPlugin saleOrderPlugin,List<InterestRateTier> rateTiers)
2422 |         {
2423 |             bool isNoReceipt = saleOrderPlugin?.NeedReturn == NeedReturnEnums.Select;
2424 |             decimal factor = isNoReceipt ? 0.5M : 1.0M;
2425 |             if (rateTiers == null || !rateTiers.Any())
2426 |                 return (0,0);
2427 | 
