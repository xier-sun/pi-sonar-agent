2421 |         private static (decimal,decimal) CalculatePenaltyAmount( HistoricalOverdueCalculationService.OverDueAmountAndDays overdueInfo,  SaleOrderPlugin saleOrderPlugin,List<InterestRateTier> rateTiers)
2422 |         {
2423 |             bool isNoReceipt = saleOrderPlugin?.NeedReturn == NeedReturnEnums.Select;
2424 |             decimal factor = isNoReceipt ? 0.5M : 1.0M;
2425 |             if (rateTiers == null || !rateTiers.Any())
2426 |                 return (0,0);
2427 | 
2428 |             // 匹配当前逾期天数对应的利率
2429 | 
2430 |             var matchedTier = rateTiers.FirstOrDefault(tier => 
2431 |                 (tier.Min == null || overdueInfo.U_OverDue_Days >= tier.Min) && 
2432 |                 (tier.Max == null || overdueInfo.U_OverDue_Days <= tier.Max));
2433 |             if (matchedTier == null)
2434 |                 return (0,0);
2435 | 
2436 |             // 计算每日利率
2437 |             decimal dailyRate = matchedTier.Rate.Value / 100m / 365m;
2438 | 
2439 |             // 计算罚息金额
2440 |             return (overdueInfo.U_Due_Amt * dailyRate * factor,dailyRate);
2441 |         }
