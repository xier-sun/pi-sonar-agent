+                    SlpCode = slp != null ? slp.SlpCode : (int?)null,

+                    orct.CardCode,

+                    orct.CardName,

+                    orct.DocEntry,

+                    orct.DocDueDate,

+                    PostingDate = orct.DocDate,

+                    orct.DocTotalSy,

+                    orct.OpenBal,

+                }).ToListAsync();

+

+            result.AddRange(data.Select(x => new AgingRawItem

