+        /// <summary>

+        /// 处理新事件立案

+        /// </summary>

+        /// <param name="newEvents"></param>

+        /// <returns></returns>

+        private async Task ProcessNewEventsAsync(System.Collections.Generic.IEnumerable<OpenAuth.App.Finance.Dto.PenaltyEventDto> newEvents)

+        {

+            var addDbEvent = new List<PenaltyEvent>();

+            foreach (var eventData in newEvents)

+            {

+                // 检查是否已立案 (防止重跑)

+                bool isAlreadyActive = await UnitWork.Find<PenaltyEvent>(null).AnyAsync(e =>

+                    e.RuleDefinitionId == eventData.RuleDefinitionId &&

+                    e.TriggerDocEntry == eventData.TriggerDocEntry &&

+                   (eventData.PenaltyType == "FIXED" || e.EventStatus == "ACTIVE"));

+

+                if (!isAlreadyActive)

+                {

+                    var dbEvent = new PenaltyEvent

+                    {

+                        RuleDefinitionId = eventData.RuleDefinitionId,

+                        SlpCode = eventData.SlpCode,

+                        SlpName = eventData.SlpName,

+                        TriggerDocType = eventData.TriggerDocType,

+                        TriggerDocEntry = eventData.TriggerDocEntry,

+                        SEDocEntry = eventData.SEDocEntry,

+                        PenaltyBaseAmount = eventData.PenaltyBaseAmount,

+                        TriggerEventDate = eventData.TriggerEventDate,

+                        PenaltyStartDate = eventData.PenaltyStartDate,

+                        EventStatus = "ACTIVE", // 关键：设为活跃

+                        Description = eventData.EventDescription,

+                    };

+                    addDbEvent.Add(dbEvent);

+                }

+            }

+            if (addDbEvent.Any())

+            {

+                await UnitWork.BatchAddAsync<PenaltyEvent, int>(addDbEvent.ToArray());

+            }

+        }

+

+        /// <summary>

+        /// 处理事件结案

+        /// </summary>

+        /// <param name="resolvedEvents"></param>

+        /// <returns></returns>

+        private async Task<List<PenaltyEvent>> ProcessResolvedEventsAsync(System.Collections.Generic.IEnumerable<OpenAuth.App.Finance.Dto.PenaltyEventDto> resolvedEvents)

+        {

+            var updatePenaltyEventList = new List<PenaltyEvent>();

+            if (resolvedEvents.Any())

+            {

+                var resolvedIds = resolvedEvents.Select(x => x.EventId).ToList();

+                var eventToResolve = await UnitWork.Find<PenaltyEvent>(x => x.EventStatus == "ACTIVE" && resolvedIds.Contains(x.Id)).ToListAsync();

+                foreach (var ent in eventToResolve)

+                {

+                    // 找到对应的结案信息，用户获取实际结案时间

+                    var resolveInfo = resolvedEvents.FirstOrDefault(x => x.EventId == ent.Id);

+

+                    ent.EventStatus = "RESOLVED";

+                    ent.ResolvedDate = resolveInfo?.ActualResolvedDate ?? DateTime.Now;

+

+                    updatePenaltyEventList.Add(ent);

+                }

+            }

+            return updatePenaltyEventList;

+        }

+

+        /// <summary>

+        /// 处理事件取消

+        /// </summary>

+        /// <param name="canceledEvents"></param>

+        /// <returns></returns>

+        private async Task<List<PenaltyEvent>> ProcessCanceledEventsAsync(System.Collections.Generic.IEnumerable<OpenAuth.App.Finance.Dto.PenaltyEventDto> canceledEvents)

+        {

+            var updatePenaltyEventList = new List<PenaltyEvent>();

+            if (canceledEvents.Any())

+            {

+                var canceledIds = canceledEvents.Select(x => x.EventId).ToList();

+                var eventsToCancel = await UnitWork.Find<PenaltyEvent>(x => x.EventStatus == "ACTIVE" && canceledIds.Contains(x.Id)).ToListAsync();

+                foreach (var ent in eventsToCancel)

+                {

+                    var cancelInfo = canceledEvents.FirstOrDefault(x => x.EventId == ent.Id);

+                    ent.EventStatus = "CANCELED";

+                    ent.ResolvedDate = cancelInfo?.CanceledDate ?? DateTime.Now;

+                    ent.Remark = cancelInfo?.CancelReason;

+                    updatePenaltyEventList.Add(ent);

+                }

+            }

+            return updatePenaltyEventList;

+        }

+

+        /// <summary>

+        /// 更新作业审计信息

+        /// </summary>

+        /// <param name="handlerCode"></param>

+        /// <returns></returns>

+        private async Task UpdateJobAuditAsync(string handlerCode)

+        {

+            var audit = await UnitWork.Find<PenaltyJobAudit>(x => x.HandlerCode == handlerCode).FirstOrDefaultAsync();

+            if (audit == null)

+            {

+                var addAudit = new PenaltyJobAudit

+                {

+                    HandlerCode = handlerCode,

+                    LastProcessedTimestamp = DateTime.Now

+                };

+                await UnitWork.AddAsync<PenaltyJobAudit, int>(addAudit);

+            }

+            else

+            {

+                audit.LastProcessedTimestamp = DateTime.Now;

+                await UnitWork.UpdateAsync<PenaltyJobAudit>(audit);

+            }

+        }

