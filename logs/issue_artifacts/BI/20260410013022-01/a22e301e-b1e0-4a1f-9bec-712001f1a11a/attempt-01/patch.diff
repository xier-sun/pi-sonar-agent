         /// <summary>

+        /// 获取退货单中指定订单的 Price=0 物料已退数量汇总

+        /// </summary>

+        private Dictionary<string, decimal> GetReturnedQuantityByItem(IEnumerable<dynamic> returnItemsWithDevEntry, int ordDocEntry)

+        {

+            return returnItemsWithDevEntry

+                .Where(x => x.Price == 0 && x.ResolvedDevEntry == ordDocEntry)

+                .GroupBy(x => x.ItemCode)

+                .ToDictionary(g => g.Key, g => g.Sum(s => s.Quantity));

+        }

+

+        /// <summary>

+        /// 计算未退的 Price=0 物料成本罚息金额

+        /// </summary>

+        private decimal? CalculateFixedPenaltyAmount(IEnumerable<dynamic> delivrdItems, int ordDocEntry, Dictionary<string, decimal> returnedZeroPriceQtyByItem)

+        {

+            return delivrdItems

+                .Where(x => x.Price == 0 && x.DocEntry == ordDocEntry)

+                .GroupBy(x => x.ItemCode)

+                .Sum(g =>

+                {

+                    var totalDelivrdQty = g.Sum(s => s.DelivrdQty);

+                    returnedZeroPriceQtyByItem.TryGetValue(g.Key, out var returnedQty);

+                    var unreturnedQty = totalDelivrdQty - (returnedQty ?? 0);

+                    return unreturnedQty > 0 ? unreturnedQty * g.First().LastPurPrc : (decimal?)0;

+                });

+        }

+

