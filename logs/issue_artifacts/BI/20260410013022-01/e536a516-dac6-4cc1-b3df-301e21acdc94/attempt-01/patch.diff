+        /// <summary>

+        /// 获取规则数据（内部版本）

+        /// </summary>

+        private async Task<RuleDataContext> GetRuleDataInternal(

+            IUnitWork unitWork,

+            List<MainlandCustomerTypeDto> customerTypes,

+            Dictionary<bool, PenaltyRuleDefinition> penaltyRules,

+            ORDR order,

+            Dictionary<int, SaleOrderPlugin> batchSaleOrderPlugins)

+        {

+            var context = new RuleDataContext();

+

+            batchSaleOrderPlugins.TryGetValue(order.DocEntry, out context.SaleOrderPlugin);

+

+            var customerType = customerTypes.FirstOrDefault(ct => ct.CardCode == order.CardCode);

+            var isSchoolOrResearch = customerType != null && (customerType.CardType.Contains("校") || customerType.CardType.Contains("研"));

+

+            if (!penaltyRules.TryGetValue(isSchoolOrResearch, out var rule))

+            {

+                rule = await GetApplicablePenaltyRuleInternal(unitWork, isSchoolOrResearch);

+            }

+            context.Rule = rule;

+

+            return context;

+        }

