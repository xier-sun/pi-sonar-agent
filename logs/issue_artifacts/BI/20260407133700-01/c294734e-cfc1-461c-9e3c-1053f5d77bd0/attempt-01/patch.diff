+        /// <summary>

+        /// 清理旧的未指定类型的社保记录

+        /// </summary>

+        private void CleanupOldUnspecifiedRecords(List<UserSocialsecurity> oldUnspecifiedTypeRecords, ProcessSocialsecurityRecordParams p)

+        {

+            if (oldUnspecifiedTypeRecords == null || !oldUnspecifiedTypeRecords.Any())

+            {

+                return;

+            }

+

+            p.DelSocialsecurityList.AddRange(oldUnspecifiedTypeRecords);

+            // 从 currentSecurities 中移除这些记录，以免后续逻辑再次处理或导致冲突

+            p.CurrentSecurities.RemoveAll(x => oldUnspecifiedTypeRecords.Contains(x));

+        }

+

+        /// <summary>

+        /// 重置记录的确认状态（当存在实质性变更时）

+        /// </summary>

+        private void ResetRecordConfirmationStatus(UserSocialsecurity record, ProcessSocialsecurityRecordParams p)

+        {

+            if (!p.HasSubstantiveChange)

+            {

+                return;

+            }

+

+            if (p.Type == SocialsecurityTypeEnums.Socialsecurity)

+            {

+                if (record.SIsPay == "Y")

+                {

+                    record.SIsPay = "N";

+                }

+                if (record.SIsEnd == "Y")

+                {

+                    record.SIsEnd = "N";

+                }

+            }

+            else if (p.Type == SocialsecurityTypeEnums.Accumulationfunds)

+            {

+                if (record.PIsPay == "Y")

+                {

+                    record.PIsPay = "N";

+                }

+                if (record.PIsEnd == "Y")

+                {

+                    record.PIsEnd = "N";

                 }

             }

