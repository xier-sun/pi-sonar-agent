+        private void ProcessSocialsecurityPreview(ProcessSocialsecurityPreviewParams parameters)

+        {

+            var type = parameters.IsSocialsecurity ? SocialsecurityTypeEnums.Socialsecurity : SocialsecurityTypeEnums.Accumulationfunds;

+

+            ProcessSocialsecurityRecord(new ProcessSocialsecurityRecordParams

+            {

+                CurrentSecurities = parameters.PreviewSecurities,

+                Type = type,

+                UpdateId = parameters.UpdateRequest.UpdateId,

+                UserId = parameters.SystemUserId,

+                Account = parameters.Account,

+                Name = parameters.UserName,

+                UpdateAction = parameters.IsSocialsecurity

+                    ? CreateSocialsecurityUpdateAction(parameters.UpdateRequest)

+                    : CreateAccumulationfundsUpdateAction(parameters.UpdateRequest),

+                CreateCondition = parameters.IsSocialsecurity

+                    ? CreateSocialsecurityCreateCondition(parameters.UpdateRequest)

+                    : CreateAccumulationfundsCreateCondition(parameters.UpdateRequest),

+                CreateAction = parameters.IsSocialsecurity

+                    ? CreateSocialsecurityCreateAction(parameters.UpdateRequest)

+                    : CreateAccumulationfundsCreateAction(parameters.UpdateRequest),

+                AddSocialsecurityList = parameters.PreviewAdds,

+                UpdateSocialsecurityList = parameters.PreviewUpdates,

+                DelSocialsecurityList = parameters.PreviewDeletes,

+                LoginUser = parameters.LoginUser,

+                OperationScene = PaymentOrRefundEnums.Payment,

+                HasSubstantiveChange = false

+            });

+        }

+

+        private Action<UserSocialsecurity> CreateSocialsecurityUpdateAction(UpdateSocialFundRequest request)

+        {

+            return ss => {

+                if (!string.IsNullOrEmpty(request.SocialSecurityAccount))

+                    ss.SocialsecurityAccount = request.SocialSecurityAccount;

+                if (request.IsInternship && request.BeginPaymentTime.HasValue)

+                    ss.SBeginPaymentTime = request.BeginPaymentTime;

+                if (request?.Remark != null)

+                    ss.Remark = request.Remark;

+            };

+        }

+

+        private Action<UserSocialsecurity> CreateAccumulationfundsUpdateAction(UpdateSocialFundRequest request)

+        {

+            return af => {

+                if (!string.IsNullOrEmpty(request.SocialSecurityAccount))

+                    af.SocialsecurityAccount = request.SocialSecurityAccount;

+                if (!string.IsNullOrEmpty(request.ProvidentFundBank))

+                    af.ProvidentFundBank = request.ProvidentFundBank;

+                if (!string.IsNullOrEmpty(request.ProvidentFundBankAccount))

+                    af.ProvidentFundBankAccount = request.ProvidentFundBankAccount;

+                if (request.IsInternship && request.BeginPaymentTime.HasValue)

+                    af.PBeginPaymentTime = request.BeginPaymentTime;

+                if (request?.Remark != null)

+                    af.Remark = request.Remark;

+            };

+        }

+

+        private Func<bool> CreateSocialsecurityCreateCondition(UpdateSocialFundRequest request)

+        {

+            return () =>

+                !string.IsNullOrEmpty(request.SocialSecurityAccount) ||

+                (request.IsInternship && request.BeginPaymentTime.HasValue);

+        }

+

+        private Func<bool> CreateAccumulationfundsCreateCondition(UpdateSocialFundRequest request)

+        {

+            return () =>

+                !string.IsNullOrEmpty(request.SocialSecurityAccount) ||

+                !string.IsNullOrEmpty(request.ProvidentFundBank) ||

+                !string.IsNullOrEmpty(request.ProvidentFundBankAccount) ||

+                (request.IsInternship && request.BeginPaymentTime.HasValue);

+        }

+

+        private Action<UserSocialsecurity> CreateSocialsecurityCreateAction(UpdateSocialFundRequest request)

+        {

+            return ss => {

+                ss.SocialsecurityAccount = request.SocialSecurityAccount ?? "";

+                ss.SBeginPaymentTime = request.IsInternship ? request.BeginPaymentTime : null;

+                ss.Remark = request.Remark ?? "";

+            };

+        }

+

+        private Action<UserSocialsecurity> CreateAccumulationfundsCreateAction(UpdateSocialFundRequest request)

+        {

+            return af => {

+                af.SocialsecurityAccount = request.SocialSecurityAccount ?? "";

+                af.ProvidentFundBank = request.ProvidentFundBank ?? "";

+                af.ProvidentFundBankAccount = request.ProvidentFundBankAccount ?? "";

+                af.PBeginPaymentTime = request.IsInternship ? request.BeginPaymentTime : null;

+                af.Remark = request.Remark ?? "";

+            };

+        }

