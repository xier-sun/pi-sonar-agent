+        /// <summary>

+        /// 构建报销单打印请求对象

+        /// </summary>

+        private QueryReimburseNeedPrintReq BuildReimburseNeedPrintReq(int itemModel, List<dynamic> FileLst, List<dynamic> reimfarsids, List<dynamic> reimsubsids, List<dynamic> reimotherids)

+        {

+            var req = new QueryReimburseNeedPrintReq();

+            req.Id = itemModel;

+            if (FileLst != null && FileLst.Count > 0)

+            {

+                req.Child = BuildReimbursePrintChildList(itemModel, FileLst, reimfarsids, reimsubsids, reimotherids);

+                req.NeedPrint = CalculateParentNeedPrint(req.Child);

+            }

+            else

+            {

+                req.NeedPrint = -1;

+            }

+            return req;

+        }

+

+        /// <summary>

+        /// 构建报销单打印子列表

+        /// </summary>

+        private List<QueryReimburseNeedPrintReq> BuildReimbursePrintChildList(int itemModel, List<dynamic> FileLst, List<dynamic> reimfarsids, List<dynamic> reimsubsids, List<dynamic> reimotherids)

+        {

+            var reqLst = new List<QueryReimburseNeedPrintReq>();

+            ProcessReimburseType(reimfarsids.Where(x => x.ReimburseInfoId == itemModel).ToList(), FileLst, reqLst, 2);

+            ProcessReimburseType(reimsubsids.Where(x => x.ReimburseInfoId == itemModel).ToList(), FileLst, reqLst, 3);

+            ProcessReimburseType(reimotherids.Where(x => x.ReimburseInfoId == itemModel).ToList(), FileLst, reqLst, 4);

+            return reqLst;

+        }

+

+        /// <summary>

+        /// 处理报销类型打印状态

+        /// </summary>

+        private void ProcessReimburseType(List<dynamic> reimIds, List<dynamic> FileLst, List<QueryReimburseNeedPrintReq> reqLst, int reimburseType)

+        {

+            foreach (var rr in reimIds)

+            {

+                var reqChild = new QueryReimburseNeedPrintReq { Id = rr.Id };

+                reqChild.NeedPrint = CheckNeedPrint(FileLst, rr.Id, reimburseType);

+                reqLst.Add(reqChild);

+            }

+        }

