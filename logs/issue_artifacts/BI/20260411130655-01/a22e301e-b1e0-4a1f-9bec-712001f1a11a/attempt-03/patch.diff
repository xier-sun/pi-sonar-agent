         /// <summary>

+        /// 获取退货项数据

+        /// </summary>

+        private async Task<List<dynamic>> GetReturnItemsAsync()

+        {

+            return await (from r1 in UnitWork.Find<RIN1>(null)

+                          join r in UnitWork.Find<ORIN>(null) on r1.DocEntry equals r.DocEntry

+                          join m in UnitWork.Find<OITM>(null) on r1.ItemCode equals m.ItemCode

+                          where r.CANCELED == "N" && (r.U_New_ORDRID == null || r.U_New_ORDRID == "")

+                          select new { r.DocEntry, r.U_New_ORDRID, r1.ItemCode, r1.Price, r.U_DevEntry, r1.Quantity, r1.StockValue, m.LastPurPrc, r.CreateDate, r1.BaseEntry, r1.BaseType }).ToListAsync();

+        }

+

+        /// <summary>

+        /// 获取已交货项数据

+        /// </summary>

+        private async Task<List<dynamic>> GetDeliveredItemsAsync(List<int> returnOrdrDocEntrys)

+        {

+            return await (from r1 in UnitWork.Find<RDR1>(null)

+                         join r in UnitWork.Find<ORDR>(null) on r1.DocEntry equals r.DocEntry

+                         join m in UnitWork.Find<OITM>(null) on r1.ItemCode equals m.ItemCode

+                         where r.CANCELED == "N" && r.DocStatus == "C" && r1.DelivrdQty > 0 && r1.LineStatus == "C" && r1.OpenQty == 0 && m.InvntItem == "Y"

+                         && returnOrdrDocEntrys.Contains(r.DocEntry)

+                         select new { r.DocEntry, r1.LineNum, r1.ItemCode, r1.DelivrdQty, r1.Price, m.ManSerNum, m.ManBtchNum, m.LastPurPrc, r.SlpCode }).ToListAsync();

+        }

+

