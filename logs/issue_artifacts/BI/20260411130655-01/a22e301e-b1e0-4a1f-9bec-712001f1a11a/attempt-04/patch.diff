+        /// <summary>

+        /// 处理订单组并生成罚息事件

+        /// </summary>

+        private PenaltyEventData ProcessOrderGroup(

+            IGrouping<int, dynamic> group,

+            List<dynamic> delivrdItems,

+            List<dynamic> returnItemsWithDevEntry,

+            ILookup<int, dynamic> delivrdProductsLookUp,

+            PenaltyRuleDefinition rule,

+            Dictionary<int, string> slpCodeToNameMap)

+        {

+            var thisOrdrReturnItems = group.GroupBy(x => x.ItemCode).Select(x => new { ItemCode = x.Key, TotalQty = x.Sum(s => s.Quantity) }).ToDictionary(k => k.ItemCode, v => v.TotalQty);

+            var delivrdItemsInThisOrdr = delivrdProductsLookUp[group.Key].GroupBy(x => x.ItemCode).Select(x => new { ItemCode = x.Key, TotalQty = x.Sum(s => s.DelivrdQty) }).ToDictionary(k => k.ItemCode, v => v.TotalQty);

+

+            if (!delivrdItemsInThisOrdr.All(x => x.Value == (thisOrdrReturnItems.TryGetValue(x.Key, out var returnedQty) ? returnedQty : 0)))

+            {

+                return null;

+            }

+

+            var returnedZeroPriceQtyByItem = returnItemsWithDevEntry

+                .Where(x => x.Price == 0 && x.ResolvedDevEntry == group.Key)

+                .GroupBy(x => x.ItemCode)

+                .ToDictionary(g => g.Key, g => g.Sum(s => s.Quantity));

+

+            var fixedPenaltyAmount = delivrdItems

+                .Where(x => x.Price == 0 && x.DocEntry == group.Key)

+                .GroupBy(x => x.ItemCode)

+                .Sum(g =>

+                {

+                    var totalDelivrdQty = g.Sum(s => s.DelivrdQty);

+                    returnedZeroPriceQtyByItem.TryGetValue(g.Key, out var returnedQty);

+                    var unreturnedQty = totalDelivrdQty - (returnedQty ?? 0);

+                    return unreturnedQty > 0 ? unreturnedQty * g.First().LastPurPrc : (decimal?)0;

+                });

+

+            if (!fixedPenaltyAmount.HasValue || fixedPenaltyAmount == 0)

+            {

+                return null;

+            }

+

+            var slpCode = delivrdItems.FirstOrDefault(x => x.Price == 0 && x.DocEntry == group.Key)?.SlpCode;

+            var latestDate = group.OrderByDescending(x => x.CreateDate).First().CreateDate;

+

+            return new PenaltyEventData

+            {

+                RuleDefinitionId = rule.Id,

+                SlpCode = slpCode,

+                SlpName = slpCodeToNameMap[slpCode.Value],

+                TriggerDocType = "ORDR",

+                TriggerDocEntry = group.Key.ToString(),

+                SEDocEntry = group.Key,

+                PenaltyBaseAmount = fixedPenaltyAmount.Value,

+                TriggerEventDate = latestDate,

+                PenaltyStartDate = latestDate

+            };

+        }

