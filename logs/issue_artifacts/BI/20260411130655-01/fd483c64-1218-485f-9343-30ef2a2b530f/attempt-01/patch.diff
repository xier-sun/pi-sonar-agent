+        /// <summary>

+        /// 处理间接收款获取和映射构建

+        /// </summary>

+        /// <param name="orderIds">订单ID列表</param>

+        /// <returns>间接收款数据</returns>

+        private async Task<(List<ORCT> receipts, List<(int DocNum, int? DocEntry, decimal? SumApplied, decimal? AppliedFC)> rct2Raw,

+            Dictionary<int, List<int>> rct2ToInv1Map, Dictionary<int, int> dln1ToOrderMap, Dictionary<int, int> inv1ToDln1Map)>

+            ProcessIndirectReceiptsAsync(List<int> orderIds)

+        {

+            var receipts = new List<ORCT>();

+            var rct2Raw = new List<(int DocNum, int? DocEntry, decimal? SumApplied, decimal? AppliedFC)>();

+            var rct2ToInv1Map = new Dictionary<int, List<int>>();

+            var dln1ToOrderMap = new Dictionary<int, int>();

+            var inv1ToDln1Map = new Dictionary<int, int>();

+

+            // 2.1 获取所有关联订单的DLN1记录

+            var dln1Entries = await UnitWork.Find<DLN1>(de =>

+                de.BaseEntry.HasValue && orderIds.Contains(de.BaseEntry.Value) &&

+                de.BaseType == 17)

+                .Select(de => new { BaseEntry = de.BaseEntry.Value, de.DocEntry })

+                .ToListAsync();

+

+            if (!dln1Entries.Any())

+            {

+                return (receipts, rct2Raw, rct2ToInv1Map, dln1ToOrderMap, inv1ToDln1Map);

+            }

+

+            // 2.2 获取所有关联的INV1记录（含BaseEntry用于构建map）

+            var dln1DocEntries = dln1Entries.Select(de => => de.DocEntry).Distinct().ToList();

+            var inv1Full = await UnitWork.Find<INV1>(ie =>

+                dln1DocEntries.Contains(ie.BaseEntry) &&

+                ie.BaseType == 15)

+                .Select(ie => => new { ie.DocEntry, ie.BaseEntry })

+                .ToListAsync();

+

+            var inv1DocEntries = inv1Full.Select(ie => => ie.DocEntry).Distinct().ToList();

+

+            if (!inv1DocEntries.Any())

+            {

+                return (receipts, rct2Raw, rct2ToInv1Map, dln1ToOrderMap, inv1ToDln1Map);

+            }

+

+            // 2.3 获取所有关联的RCT2记录（含SumApplied/AppliedFC），合并到 rct2Raw 供间接收款路径分配

+            var indirectRct2 = await UnitWork.Find<RCT2>(re =>

+                inv1DocEntries.Contains(re.DocEntry) &&

+                re.InvType == "13")

+                .Select(re => => new { re.DocNum, re.DocEntry, re.SumApplied, re.AppliedFC })

+                .ToListAsync();

+            rct2Raw.AddRange(indirectRct2.Select(re => => (re.DocNum, re.DocEntry, re.SumApplied, re.AppliedFC)));

+

+            if (!rct2Raw.Any())

+            {

+                return (receipts, rct2Raw, rct2ToInv1Map, dln1ToOrderMap, inv1ToDln1Map);

+            }

+

+            // 2.4 获取所有关联的ORCT记录（间接收款）

+            var rctDocNums = rct2Raw.Select(re => => re.DocNum).Distinct().ToList();

+            receipts = await UnitWork.Find<ORCT>(r =>

+                rctDocNums.Contains(r.DocNum) &&

+                r.Canceled != "Y" &&

+                !r.U_XSDD.HasValue)

+                .ToListAsync();

+

+            // 2.5 构建映射

+            dln1ToOrderMap = dln1Entries

+                .GroupBy(x => x.DocEntry)

+                .ToDictionary(g => g.Key.Value, g => g.First().BaseEntry);

+

+            inv1ToDln1Map = inv1Full

+                .GroupBy(x => x.DocEntry)

+                .ToDictionary(g => g.Key.Value, g => g.First().BaseEntry.Value);

+

+            // rct2ToInv1Map: DocNum → [inv1DocEntries]

+            rct2ToInv1Map = rct2Raw

+                .Where(re => => re.DocEntry.HasValue)

+                .GroupBy(re => => re.DocNum)

+                .ToDictionary(g => g.Key, g => g.Select(re => => re.DocEntry.Value).ToList());

+

+            return (receipts, rct2Raw, rct2ToInv1Map, dln1ToOrderMap, inv1ToDln1Map);

+        }

+

+        /// <summary>

+        /// 将间接收款按订单分配（聚合SumApplied，一张收款单可核销多订单的发票）

+        /// </summary>

+        /// <param name="indirectReceipts">间接收款数据</param>

+        /// <param name="result">结果字典</param>

+        private void DistributeIndirectReceiptsToOrders(

+            (List<ORCT> receipts, List<(int DocNum, int? DocEntry, decimal? SumApplied, decimal? AppliedFC)> rct2Raw,

+                Dictionary<int, List<int>> rct2ToInv1Map, Dictionary<int, int> dln1ToOrderMap,

+                Dictionary<int, int> inv1ToDln1Map) indirectReceipts,

+            Dictionary<int, List<ReceiptForOrder>> result)

+        {

+            var receipts = indirectReceipts.receipts;

+            var rct2Raw = indirectReceipts.rct2Raw;

+            var rct2ToInv1Map = indirectReceipts.rct2ToInv1Map;

+            var dln1ToOrderMap = indirectReceipts.dln1ToOrderMap;

+            var inv1ToDln1Map = indirectReceiptReceipts.inv1ToDln1Map;

+

+            foreach (var receipt in receipts)

+            {

+                if (!rct2ToInv1Map.TryGetValue(receipt.DocNum, out var inv1DocEntriesForReceipt))

+                    continue;

+

+                // 找出该收款单关联到哪些订单及其对应发票

+                var orderToInv1 = new Dictionary<int, List<int>>();

+                foreach (var inv1DocEntry in inv1DocEntriesForReceipt)

+                {

+                    if (inv1ToDln1Map.TryGetValue(inv1DocEntry, out var dln1DocEntry) &&

+                        dln1ToOrderMap.TryGetValue(dln1DocEntry, out var orderId))

+                    {

+                        if (!orderToInv1.ContainsKey(orderId))

+                            orderToInv1[orderId] = new List<int>();

+                        orderToInv1[orderId].Add(inv1DocEntry);

+                    }

+                }

+

+                foreach (var kv in orderToInv1)

+                {

+                    var orderId = kv.Key;

+                    var thisOrderInv1 = kv.Value;

+

+                    // 只累加核销到本订单发票的金额

+                    var matchingRct2 = rct2Raw

+                        .Where(re => => re.DocNum == receipt.DocNum && re.DocEntry.HasValue && thisOrderInv1.Contains(re.DocEntry.Value))

+                        .ToList();

+                    var appliedAmount = matchingRct2.Sum(re => => re.SumApplied ?? 0M);

+                    var appliedAmountFC = matchingRct2.Sum(re => => re.AppliedFC ?? 0M);

+

+                    if (!result.ContainsKey(orderId))

+                        result[orderId] = new List<ReceiptForOrder>();

+

+                    result[orderId].Add(new ReceiptForOrder

+                    {

+                        DocEntry = receipt.DocEntry,

+                        DocNum = receipt.DocNum,

+                        DocDate = receipt.DocDate,

+                        Canceled = receipt.Canceled,

+                        AppliedAmount = appliedAmount,

+                        AppliedAmountFC = appliedAmountFC

+                    });

+                }

+            }

         }

 

         /// <summary>
