         /// <summary>

+        /// 对销售员回款汇总结果进行动态排序

+        /// </summary>

+        /// <param name="result"></param>

+        /// <param name="sortName"></param>

+        /// <param name="sortOrder"></param>

+        /// <returns></returns>

+        private static List<SalesReceiptSummaryResp> ApplySorting(List<SalesReceiptSummaryResp> result, string sortName, string sortOrder)

+        {

+            if (string.IsNullOrEmpty(sortName))

+            {

+                return result.OrderByDescending(x => x.TotalReceiptAmount).ToList();

+            }

+

+            var propertyInfo = typeof(SalesReceiptSummaryResp).GetProperty(sortName,

+                System.Reflection.BindingFlags.IgnoreCase | System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);

+

+            if (propertyInfo == null)

+            {

+                return result.OrderByDescending(x => x.TotalReceiptAmount).ToList();

+            }

+

+            bool isAsc = string.Equals(sortOrder, "asc", StringComparison.OrdinalIgnoreCase);

+

+            return isAsc

+                 ? result.OrderBy(r => propertyInfo.GetValue(r, null)).ToList()

+                 : result.OrderByDescending(r => propertyInfo.GetValue(r, null)).ToList();

+        }

