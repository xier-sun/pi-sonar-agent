+

+            // 未退的 Price=0 物料成本 = sum(未退数量 * LastPurPrc)

+            var fixedPenaltyAmount = CalculateUnreturnedZeroPenaltyAmount(delivrdItems, group.Key, returnedZeroPriceQtyByItem);

