+        /// <summary>

+        /// 尝试为订单创建罚息事件

+        /// </summary>

+        private PenaltyEventData TryCreatePenaltyEventForOrder(

+            IGrouping<int, dynamic> group,

+            ILookup<int, dynamic> delivrdProductsLookUp,

+            List<dynamic> returnItemsWithDevEntry,

+            List<dynamic> delivrdItems,

+            string ruleId,

+            Dictionary<string, string> slpCodeToNameMap)

+        {

+            var thisOrdrReturnItems = group.GroupBy(x => x.ItemCode)

+                .Select(x => new { ItemCode = x.Key, TotalQty = x.Sum(s => s.Quantity) })

+                .ToDictionary(k => k.ItemCode, v => v.TotalQty);

+

+            var delivrdItemsInThisOrdr = delivrdProductsLookUp[group.Key]

+                .GroupBy(x => x.ItemCode)

+                .Select(x => new { ItemCode = x.Key, TotalQty = x.Sum(s => s.DelivrdQty) })

+                .ToDictionary(k => k.ItemCode, v => v.TotalQty);

+

+            // 遍历订单中所有有价物料，检查每个物料是否都已退完

+            if (!AreAllPriceableItemsReturned(delivrdItemsInThisOrdr, thisOrdrReturnItems))

+            {

+                return null;

+            }

+

+            var returnedZeroPriceQtyByItem = GetReturnedZeroPriceQuantityByItem(returnItemsWithDevEntry, group.Key);

+            var fixedPenaltyAmount = CalculateFixedPenaltyAmount(delivrdItems, group.Key, returnedZeroPriceQtyByItem);

+            var slpCode = GetSalesPersonCode(delivrdItems, group.Key);

+

+            if (!fixedPenaltyAmount.HasValue || fixedPenaltyAmount == 0)

+            {

+                return null;

+            }

+

+            var latestDate = group.OrderByDescending(x => x.CreateDate).First().CreateDate;

+

+            return new PenaltyEventData

+            {

+                RuleDefinitionId = ruleId,

+                SlpCode = slpCode,

+                SlpName = slpCodeToNameMap[slpCode.Value],

+                TriggerDocType = "ORDR",

+                TriggerDocEntry = group.Key.ToString(),

+                SEDocEntry = group.Key,

+                PenaltyBaseAmount = fixedPenaltyAmount.Value,

+                TriggerEventDate = latestDate,

+                PenaltyStartDate = latestDate,

+            };

+        }

+

+        /// <summary>

+        /// 检查所有有价物料是否都已退货

+        /// </summary>

+        private bool AreAllPriceableItemsReturned(Dictionary<string, decimal> delivrdItems, Dictionary<string, decimal> returnedItems)

+        {

+            return delivrdItems.All(x =>

+                x.Value == (returnedItems.TryGetValue(x.Key, out var returnedQty) ? returnedQty : 0));

+        }

+

+        /// <summary>

+        /// 获取零价格物料的已退数量

+        /// </summary>

+        private Dictionary<string, decimal> GetReturnedZeroPriceQuantityByItem(List<dynamic> returnItemsWithDevEntry, int orderDocEntry)

+        {

+            return returnItemsWithDevEntry

+                .Where(x => x.Price == 0 && x.ResolvedDevEntry == orderDocEntry)

+                .GroupBy(x => x.ItemCode)

+                .ToDictionary(g => g.Key, g => g.Sum(s => s.Quantity));

+        }

+

+        /// <summary>

+        /// 计算固定罚息金额

+        /// </summary>

+        private decimal? CalculateFixedPenaltyAmount(List<dynamic> delivrdItems, int orderDocEntry, Dictionary<string, decimal> returnedZeroPriceQtyByItem)

+        {

+            return delivrdItems

+                .Where(x => x.Price == 0 && x.DocEntry == orderDocEntry)

+                .GroupBy(x => x.ItemCode)

+                .Sum(g =>

+                {

+                    var totalDelivrdQty = g.Sum(s => s.DelivrdQty);

+                    returnedZeroPriceQtyByItem.TryGetValue(g.Key, out var returnedQty);

+                    var unreturnedQty = totalDelivrdQty - (returnedQty ?? 0);

+                    return unreturnedQty > 0 ? unreturnedQty * g.First().LastPurPrc : (decimal?)0;

+                });

+        }

+

+        /// <summary>

+        /// 获取销售员代码

+        /// </summary>

+        private int? GetSalesPersonCode(List<dynamic> delivrdItems, int orderDocEntry)

+        {

+            return delivrdItems.FirstOrDefault(x => x.Price == 0 && x.DocEntry == orderDocEntry)?.SlpCode;

         }

 

