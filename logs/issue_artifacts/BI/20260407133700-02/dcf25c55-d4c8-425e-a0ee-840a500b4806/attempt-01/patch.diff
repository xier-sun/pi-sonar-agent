+        private static void DistributeIndirectReceipts(

+            Dictionary<int, List<ReceiptForOrder>> result,

+            List<ORCT> indirectReceipts,

+            IndirectReceiptMappings mappings)

+        {

+            foreach (var receipt in indirectReceipts)

+            {

+                if (!mappings.Rct2ToInv1Map.TryGetValue(receipt.DocNum, out var inv1DocEntriesForReceipt))

+                    continue;

+

+                // 找出该收款单关联到哪些订单及其对应发票

+                var orderToInv1 = BuildOrderToInv1Mapping(inv1DocEntriesForReceipt, mappings);

+

+                foreach (var kv in orderToInv1)

+                {

+                    var orderId = kv.Key;

+                    var thisOrderInv1 = kv.Value;

+

+                    // 只累加核销到本订单发票的金额

+                    var matchingRct2 = mappings.Rct2Raw

+                        .Where(re => re.DocNum == receipt.DocNum && re.DocEntry.HasValue && thisOrderInv1.Contains(re.DocEntry.Value))

+                        .ToList();

+                    var appliedAmount = matchingRct2.Sum(re => re.SumApplied ?? 0M);

+                    var appliedAmountFC = matchingRct2.Sum(re => re.AppliedFC ?? 0M);

+

+                    if (!result.ContainsKey(orderId))

+                        result[orderId] = new List<ReceiptForOrder>();

+

+                    result[orderId].Add(new ReceiptForOrder

+                    {

+                        DocEntry = receipt.DocEntry,

+                        DocNum = receipt.DocNum,

+                        DocDate = receipt.DocDate,

+                        Canceled = receipt.Canceled,

+                        AppliedAmount = appliedAmount,

+                        AppliedAmountFC = appliedAmountFC

+                    });

+                }

+            }

+        }

