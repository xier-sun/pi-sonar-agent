+                // 本地函数：处理可清账事件逻辑

+                void ProcessCanClearReconEvents()

+                {

+                    if (!events.Any(e => e.EventType == OrderEventType.CanClearRecon))

+                        return;

+

+                    var canClearReconIndex = events.FindIndex(e => e.EventType == OrderEventType.CanClearRecon);

+                    var canClearReconDate = events[canClearReconIndex].EventDate;

+

+                    // 若有和可清账事件同一天的事件，去掉其他同一天的事件，只保留可清账事件

+                    events = events.Where(e => e.EventType == OrderEventType.CanClearRecon || e.EventDate != canClearReconDate).ToList();

+

+                    // 重新排序事件

+                    events = events.OrderBy(e => e.EventDate).ToList();

+

+                    // 重新获取 CanClearRecon 事件的索引

+                    canClearReconIndex = events.FindIndex(e => e.EventType == OrderEventType.CanClearRecon);

+

+                    // 如果前面还有别的事件，使用前一个事件的金额作为清账事件的金额

+                    if (canClearReconIndex > 0)

+                    {

+                        events[canClearReconIndex].Amount = events[canClearReconIndex - 1].Amount;

+                    }

+                    events = events.Take(canClearReconIndex + 1).ToList();

+                }

