+            // 加载直接收款

+            var directReceiptsByOrder = await LoadDirectReceiptsAsync(orderIds);

+

+            // 加载间接收款数据

+            var (indirectRct2DocNums, allRct2, orderToInv1Entries) = await LoadIndirectReceiptDataAsync(orderIds);

+

+            // 处理间接收款

+            await ProcessIndirectReceiptsAsync(orderIds, indirectRct2DocNums, allRct2, orderToInv1Entries, receiptDict, directReceiptsByOrder);

+

+            // 处理直接收款

+            ProcessDirectReceiptsAsync(orderIds, directReceiptsByOrder, receiptDict);

+

+            // 对每个订单的收款按日期排序并去重

+            DeduplicateAndSortReceipts(receiptDict);

