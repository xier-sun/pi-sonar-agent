+        /// <summary>

+        /// 加载订单开票信息

+        /// </summary>

+        private async Task<Dictionary<int, List<InvoiceHistoryItem>>> LoadInvoicesAsync(List<int> orderIds)

+        {

+            var invoiceDict = new Dictionary<int, List<InvoiceHistoryItem>>();

+            var mastersList = await UnitWork.Find<FinancebillapplicationMaster>(m => orderIds.Contains(m.DocEntry) && !string.IsNullOrEmpty(m.CardCode))

+                .Select(m => new { m.Id, m.DocEntry })

+                .ToListAsync();

+            var masterIds = mastersList.Select(m => m.Id).ToList();

+            var taxDetailsList = await UnitWork.Find<FinancebillapplicationTaxdetails>(t => masterIds.Contains(t.BillId) && t.TaxDate != null && t.TaxAmount > 0m)

+                .ToListAsync();

+

+            foreach (var master in mastersList)

+            {

+                var details = taxDetailsList.Where(td => td.BillId == master.Id)

+                    .Select(td => new InvoiceHistoryItem

+                    {

+                        InvoiceDate = td.TaxDate.Value,

+                        InvoiceAmount = td.TaxAmount.Value,

+                        BillId = master.Id,

+                        TaxNo = td.TaxNo

+                    }).OrderBy(item => item.InvoiceDate).ToList();

+

+                if (!invoiceDict.ContainsKey(master.DocEntry))

+                    invoiceDict[master.DocEntry] = new List<InvoiceHistoryItem>();

+                invoiceDict[master.DocEntry].AddRange(details);

+            }

+            return invoiceDict;

+        }

