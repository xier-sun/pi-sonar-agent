+        /// <summary>

+        /// 加载 DLN1 数据

+        /// </summary>

+        private async Task<(Dictionary<int, List<int>> dln1EntriesDict, List<int> allDlnEntries)> LoadDln1DataAsync(List<int> orderIds)

+        {

+            var dln1AllResults = new List<(int BaseEntry, int DocEntry)>();

+            const int batchSize = 1000;

+            for (int i = 0; i < orderIds.Count; i += batchSize)

+            {

+                var batchIds = orderIds.Skip(i).Take(batchSize).ToList();

+                var batch = await UnitWork.Find<DLN1>(de => de.BaseEntry.HasValue && batchIds.Contains(de.BaseEntry.Value) && de.BaseType == 17)

+                    .Select(de => new { BaseEntry = de.BaseEntry.Value, DocEntry = de.DocEntry.Value })

+                    .ToListAsync();

+                dln1AllResults.AddRange(batch.Select(x => (x.BaseEntry, x.DocEntry)));

+            }

+            var dln1EntriesDict = dln1AllResults

+                .GroupBy(x => x.BaseEntry)

+                .ToDictionary(g => g.Key, g => g.Select(x => x.DocEntry).ToList());

+            var allDlnEntries = dln1AllResults.Select(x => x.DocEntry).Distinct().ToList();

+            return (dln1EntriesDict, allDlnEntries);

+        }

+

+        /// <summary>

+        /// 加载 INV1 和 RCT2 数据

+        /// </summary>

+        private async Task<(Dictionary<int, List<int>> inv1EntriesDict, List<(int DocNum, int InvDocEntry, decimal SumApplied, decimal AppliedFC)> allRct2)> LoadInv1AndRct2DataAsync(List<int> allDlnEntries)

+        {

+            var inv1EntriesDict = new Dictionary<int, List<int>>();

+            var allRct2 = new List<(int DocNum, int InvDocEntry, decimal SumApplied, decimal AppliedFC)>();

+

+            if (!allDlnEntries.Any())

+                return (inv1EntriesDict, allRct2);

+

+            // 加载 INV1 数据

+            var inv1AllResults = new List<(int BaseEntry, int DocEntry)>();

+            const int batchSize = 1000;

+            for (int i = 0; i < allDlnEntries.Count; i += batchSize)

+            {

+                var batchIds = allDlnEntries.Skip(i).Take(batchSize).ToList();

+                var batch = await UnitWork.Find<INV1>(ie => ie.BaseEntry.HasValue && batchIds.Contains(ie.BaseEntry.Value) && ie.BaseType == 15)

+                    .Select(ie => new { BaseEntry = ie.BaseEntry.Value, DocEntry = ie.DocEntry.Value })

+                    .ToListAsync();

+                inv1AllResults.AddRange(batch.Select(x => (x.BaseEntry, x.DocEntry)));

+            }

+            inv1EntriesDict = inv1AllResults

+                .GroupBy(x => x.BaseEntry)

+                .ToDictionary(g => g.Key, g => g.Select(x => x.DocEntry).ToList());

+

+            var allInvEntries = inv1AllResults.Select(x => x.DocEntry).Distinct().ToList();

+            if (allInvEntries.Any())

+            {

+                // 加载 RCT2 数据

+                for (int i = 0; i < allInvEntries.Count; i += batchSize)

+                {

+                    var batchIds = allInvEntries.Skip(i).Take(batchSize).ToList();

+                    var batch = await UnitWork.Find<RCT2>(re => re.DocEntry.HasValue && batchIds.Contains(re.DocEntry.Value) && re.InvType == "13")

+                        .Select(re => new { re.DocNum, DocEntry = re.DocEntry, re.SumApplied, re.AppliedFC })

+                        .ToListAsync();

+                    allRct2.AddRange(batch

+                        .Where(re => re.DocEntry.HasValue)

+                        .Select(re => (re.DocNum, re.DocEntry.Value, re.SumApplied ?? 0M, re.AppliedFC ?? 0M)));

+                }

+            }

+

+            return (inv1EntriesDict, allRct2);

+        }

+

+        /// <summary>

+        /// 构建订单到发票的映射关系

+        /// </summary>

+        private Dictionary<int, List<int>> BuildOrderToInv1Mapping(List<int> orderIds, Dictionary<int, List<int>> dln1EntriesDict, Dictionary<int, List<int>> inv1EntriesDict)

+        {

+            var orderToInv1Entries = new Dictionary<int, List<int>>();

+            foreach (var orderId in orderIds)

+            {

+                if (!dln1EntriesDict.TryGetValue(orderId, out var dlnEntries))

+                    continue;

+

+                var inv1 = new List<int>();

+                foreach (var dlnEntry in dlnEntries)

+                {

+                    if (inv1EntriesDict.TryGetValue(dlnEntry, out var invEntries))

+                        inv1.AddRange(invEntries);

+                }

+                if (inv1.Any())

+                    orderToInv1Entries[orderId] = inv1;

+            }

+            return orderToInv1Entries;

+        }

+

+        /// <summary>

+        /// 处理间接收款

+        /// </summary>

+        private async Task ProcessIndirectReceiptsAsync(List<int> orderIds, List<int> indirectRct2DocNums, List<(int DocNum, int InvDocEntry, decimal SumApplied, decimal AppliedFC)> allRct2, Dictionary<int, List<int>> orderToInv1Entries, Dictionary<int, List<ReceiptForOrder>> receiptDict, Dictionary<int, List<ORCT>> directReceiptsByOrder)

+        {

+            var directDocNums = directReceiptsByOrder.SelectMany(x => x.Value).Select(r => r.DocNum).ToHashSet();

+            var indirectDocNums = indirectRct2DocNums.Where(n => !directDocNums.Contains(n)).Distinct().ToList();

+

+            if (!indirectDocNums.Any())

+                return;

+

+            // 加载间接收款的 ORCT

+            var indirectReceiptsDict = new Dictionary<int, ORCT>();

+            const int batchSize = 1000;

+            for (int i = 0; i < indirectDocNums.Count; i += batchSize)

+            {

+                var batchNums = indirectDocNums.Skip(i).Take(batchSize).ToList();

+                var batch = await UnitWork.Find<ORCT>(r => batchNums.Contains(r.DocNum) && r.Canceled != "Y" && !r.U_XSDD.HasValue).ToListAsync();

+                foreach (var receipt in batch)

+                {

+                    indirectReceiptsDict[receipt.DocNum] = receipt;

+                }

+            }

+

+            foreach (var orderId in orderIds)

+            {

+                if (!orderToInv1Entries.TryGetValue(orderId, out var thisOrderInv1))

+                    continue;

+

+                var relatedRct2 = allRct2.Where(r => thisOrderInv1.Contains(r.InvDocEntry)).ToList();

+                var relatedIndirectDocNums = relatedRct2.Select(r => r.DocNum).Where(n => !directDocNums.Contains(n)).Distinct().ToHashSet();

+

+                foreach (var rctDocNum in relatedIndirectDocNums)

+                {

+                    if (!indirectReceiptsDict.TryGetValue(rctDocNum, out var receipt))

+                        continue;

+

+                    var matchingRct2 = relatedRct2.Where(r => r.DocNum == rctDocNum).ToList();

+                    var appliedAmount = matchingRct2.Sum(r => r.SumApplied);

+                    var appliedAmountFC = matchingRct2.Sum(r => r.AppliedFC);

+

+                    if (!receiptDict.ContainsKey(orderId))

+                        receiptDict[orderId] = new List<ReceiptForOrder>();

+                    receiptDict[orderId].Add(new ReceiptForOrder

+                    {

+                        DocEntry = receipt.DocEntry,

+                        DocNum = receipt.DocNum,

+                        DocDate = receipt.DocDate,

+                        Canceled = receipt.Canceled,

+                        AppliedAmount = appliedAmount,

+                        AppliedAmountFC = appliedAmountFC

+                    });

+                }

+            }

+        }

+

+        /// <summary>

+        /// 处理直接收款

+        /// </summary>

+        private void ProcessDirectReceiptsAsync(List<int> orderIds, Dictionary<int, List<ORCT>> directReceiptsByOrder, Dictionary<int, List<ReceiptForOrder>> receiptDict)

+        {

+            foreach (var orderId in orderIds)

+            {

+                if (!directReceiptsByOrder.TryGetValue(orderId, out var orderDirectReceipts))

+                    continue;

+

+                foreach (var receipt in orderDirectReceipts)

+                {

+                    if (!receiptDict.ContainsKey(orderId))

+                        receiptDict[orderId] = new List<ReceiptForOrder>();

+                    receiptDict[orderId].Add(new ReceiptForOrder

+                    {

+                        DocEntry = receipt.DocEntry,

+                        DocNum = receipt.DocNum,

+                        DocDate = receipt.DocDate,

+                        Canceled = receipt.Canceled,

+                        AppliedAmount = receipt.DocTotal ?? 0M,

+                        AppliedAmountFC = receipt.DocTotalFC ?? 0M

+                    });

+                }

+            }

+        }

+

+        /// <summary>

+        /// 对收款记录去重并排序

+        /// </summary>

+        private void DeduplicateAndSortReceipts(Dictionary<int, List<ReceiptForOrder>> receiptDict)

+        {

+            var orderIdsToUpdate = receiptDict.Keys.ToList();

+            foreach (var orderId in orderIdsToUpdate)

+            {

+                receiptDict[orderId] = receiptDict[orderId]

+                    .GroupBy(r => r.DocEntry)

+                    .Select(g => new ReceiptForOrder

+                    {

+                        DocEntry = g.Key,

+                        DocNum = g.First().DocNum,

+                        DocDate = g.First().DocDate,

+                        Canceled = g.First().Canceled,

+                        AppliedAmount = g.Sum(r => r.AppliedAmount),

+                        AppliedAmountFC = g.Sum(r => r.AppliedFC)

+                    })

+                    .OrderBy(r => r.DocDate)

+                    .ToList();

+            }

+        }

