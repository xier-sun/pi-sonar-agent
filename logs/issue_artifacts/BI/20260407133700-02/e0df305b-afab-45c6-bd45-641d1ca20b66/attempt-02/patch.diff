+        /// <summary>

+        /// 加载可清截止日期

+        /// </summary>

+        private async Task<Dictionary<int, DateTime?>> LoadCanClearCutOffDatesAsync(List<int> orderIds)

+        {

+            var canClearCutOffDates = new Dictionary<int, DateTime?>();

+

+            var batchSaleOrderRemarkCanClear = await UnitWork.Find<SaleOrdrRemark>(r =>

+                orderIds.Contains(r.DocEntry) &&

+                r.SboId == SboIdEnums.neware_201304 &&

+                r.Remark.Contains("【可清单】"))

+                .ToListAsync();

+

+            var batchSaleOrderRemarkCannotClear = await UnitWork.Find<SaleOrdrRemark>(r =>

+                orderIds.Contains(r.DocEntry) &&

+                r.SboId == SboIdEnums.neware_201304 &&

+                r.Remark.Contains("不可清单"))

+                .ToListAsync();

+

+            var canClearDict = batchSaleOrderRemarkCanClear.GroupBy(x => x.DocEntry).ToDictionary(g => g.Key, g => g.OrderByDescending(x => x.CreateDate).First());

+            var cannotClearDict = batchSaleOrderRemarkCannotClear.GroupBy(x => x.DocEntry).ToDictionary(g => g.Key, g => g.OrderByDescending(x => x.CreateDate).First());

+

+            foreach (var orderId in orderIds)

+            {

+                var hasCanClear = canClearDict.TryGetValue(orderId, out var canClearRemark);

+                var hasCannotClear = cannotClearDict.TryGetValue(orderId, out var cannotClearRemark);

+

+                if ((hasCanClear && !hasCannotClear) || (hasCanClear && hasCannotClear && canClearRemark.CreateDate > cannotClearRemark.CreateDate))

+                {

+                    canClearCutOffDates[orderId] = canClearRemark.CreateDate.Date;

+                }

+            }

+

+            return canClearCutOffDates;

