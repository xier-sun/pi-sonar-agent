+        /// <summary>

+        /// 加载直接收款记录

+        /// </summary>

+        private async Task<Dictionary<int, List<ORCT>>> LoadDirectReceiptsAsync(List<int> orderIds)

+        {

+            var directReceiptsList = new List<ORCT>();

+            const int batchSize = 1000;

+            for (int i = 0; i < orderIds.Count; i += batchSize)

+            {

+                var batchIds = orderIds.Skip(i).Take(batchSize).ToList();

+                var batchResult = await UnitWork.Find<ORCT>(r => r.U_XSDD.HasValue && batchIds.Contains(r.U_XSDD.Value) && r.Canceled != "Y")

+                    .ToListAsync();

+                directReceiptsList.AddRange(batchResult);

+            }

+            return directReceiptsList

+                .GroupBy(r => r.U_XSDD.Value)

+                .ToDictionary(g => g.Key, g => g.ToList());

+        }

+

+        /// <summary>

+        /// 加载间接收款相关数据

+        /// </summary>

+        private async Task<(List<int> indirectRct2DocNums, List<(int DocNum, int InvDocEntry, decimal SumApplied, decimal AppliedFC)> allRct2, Dictionary<int, List<int>> orderToInv1Entries)> LoadIndirectReceiptDataAsync(List<int> orderIds)

+        {

+            // 加载 DLN1 数据

+            var (dln1EntriesDict, allDlnEntries) = await LoadDln1DataAsync(orderIds);

+

+            // 加载 INV1 和 RCT2 数据

+            var (inv1EntriesDict, allRct2) = await LoadInv1AndRct2DataAsync(allDlnEntries);

+

+            // 构建 orderId → 本订单所有发票 DocEntry 的映射

+            var orderToInv1Entries = BuildOrderToInv1Mapping(orderIds, dln1EntriesDict, inv1EntriesDict);

+

+            // 提取间接收款的 DocNum

+            var indirectRct2DocNums = allRct2.Select(r => r.DocNum).Distinct().ToList();

+

+            return (indirectRct2DocNums, allRct2, orderToInv1Entries);

+        }

