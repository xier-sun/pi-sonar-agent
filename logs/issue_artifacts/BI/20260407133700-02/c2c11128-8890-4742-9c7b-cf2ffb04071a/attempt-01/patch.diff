+        /// <summary>

+        /// 处理报销项目并生成需要打印的子项列表

+        /// </summary>

+        /// <param name="itemIds">报销项目ID列表</param>

+        /// <param name="fileLst">附件列表</param>

+        /// <param name="reimburseType">报销类型</param>

+        /// <returns>需要打印的子项列表</returns>

+        private List<QueryReimburseNeedPrintReq> ProcessReimburseItems(List<int> itemIds, object fileLst, int reimburseType)

+        {

+            var reqLst = new List<QueryReimburseNeedPrintReq>();

+            foreach (var itemId in itemIds)

+            {

+                var reqChild = new QueryReimburseNeedPrintReq

+                {

+                    Id = itemId,

+                    NeedPrint = CheckNeedPrint(fileLst, itemId, reimburseType)

+                };

+                reqLst.Add(reqChild);

+            }

+            return reqLst;

+        }

+

+        /// <summary>

+        /// 检查指定报销项目是否需要打印

+        /// </summary>

+        /// <param name="fileLst">附件列表</param>

+        /// <param name="itemId">报销项目ID</param>

+        /// <param name="reimburseType">报销类型</param>

+        /// <returns>是否需要打印（1表示需要，0表示不需要）</returns>

+        private int CheckNeedPrint(object fileLst, int itemId, int reimburseType)

+        {

+            var fileEnumerable = fileLst as System.Collections.IEnumerable;

+            if (fileEnumerable == null)

+            {

+                return 0;

+            }

+

+            var count = 0;

+            foreach (dynamic file in fileEnumerable)

+            {

+                if (file.ReimburseId == itemId && file.IsPDF != 1 && !file.FileType.Contains("pdf") && file.ReimburseType == reimburseType)

+                {

+                    count++;

+                }

+            }

+            return count > 0 ? 1 : 0;

+        }

+

+        /// <summary>

+        /// 计算父项是否需要打印

+        /// </summary>

+        /// <param name="childLst">子项列表</param>

+        /// <returns>是否需要打印（1表示需要，0或-1表示不需要）</returns>

+        private int CalculateNeedPrint(List<QueryReimburseNeedPrintReq> childLst)

+        {

+            if (childLst != null && childLst.Count > 0 && childLst.Any(x => x.NeedPrint == 1))

+            {

+                return 1;

+            }

+            return 0;

