+        /// <summary>

+        /// 检查订单是否满足可清单条件

+        /// </summary>

+        /// <param name="ordr">销售订单</param>

+        /// <param name="ordrStat">订单状态</param>

+        /// <returns>是否可清单、回款率、人民币余额</returns>

+        private (bool shouldPlugin, decimal paymentRate, decimal balanceRMB) CheckShouldPluginAsync(ORDR ordr, OrdrStat ordrStat)

+        {

+            var docTotalRMB = ordr.DocTotal.Value;

+            if (docTotalRMB <= 0)

+                return (false, 0, 0);

+

+            var receiptAmountRMB = ordr.U_DocRCTAmount ?? 0M;

+            var uRefundAmtRMB = ordrStat.U_Refund_Amt;

+            var balanceRMB = CalculateBalanceRMB(ordr, ordrStat, docTotalRMB, receiptAmountRMB, uRefundAmtRMB);

+

+            if (ordr.DocCur == FinanceConsts.RMB)

+            {

+                if (balanceRMB <= 0)

+                    return (false, 0, balanceRMB);

+

+                var paymentRate = (receiptAmountRMB - uRefundAmtRMB) / docTotalRMB;

+                var shouldPlugin = paymentRate >= 0.98m && Math.Abs(balanceRMB) < 100m;

+                return (shouldPlugin, paymentRate, balanceRMB);

+            }

+            else

+            {

+                var (shouldPlugin, paymentRate) = CalculateForeignCurrencyPayment(ordr, ordrStat, balanceRMB);

+                return (shouldPlugin, paymentRate, balanceRMB);

+            }

+        }

+

+        /// <summary>

+        /// 计算人民币余额

+        /// </summary>

+        private decimal CalculateBalanceRMB(ORDR ordr, OrdrStat ordrStat, decimal docTotalRMB, decimal receiptAmountRMB, decimal uRefundAmtRMB)

+        {

+            if (ordr.DocStatus == "C")

+            {

+                return (ordrStat.U_Delivery_TotalAmt ?? 0) - (receiptAmountRMB - uRefundAmtRMB);

+            }

+            else

+            {

+                return docTotalRMB - (receiptAmountRMB - uRefundAmtRMB);

+            }

+        }

+

+        /// <summary>

+        /// 计算外币订单的回款率和可清单条件

+        /// </summary>

+        private (bool shouldPlugin, decimal paymentRate) CalculateForeignCurrencyPayment(ORDR ordr, OrdrStat ordrStat, decimal balanceRMB)

+        {

+            var docTotalFC = ordr.DocTotalFC.Value;

+            var receiptAmountFC = ordrStat.U_Receipt_TotalAmtFC ?? 0M;

+            var uRefundAmtFC = ordrStat.U_Refund_AmtFC;

+

+            if (docTotalFC <= 0)

+                return (false, 0);

+

+            if (docTotalFC - (receiptAmountFC - uRefundAmtFC) <= 0)

+                return (false, 0);

+

+            var paymentRate = (receiptAmountFC - uRefundAmtFC) / docTotalFC;

+            var shouldPlugin = paymentRate >= 0.98m && Math.Abs(balanceRMB) < 100m;

+            return (shouldPlugin, paymentRate);

+        }

+

