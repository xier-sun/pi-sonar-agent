+        /// <summary>

+        /// 处理罚息计算逻辑

+        /// </summary>

+        private void ProcessPenaltyCalculation(

+            List<dynamic> returnItemsWithDevEntry,

+            List<dynamic> delivrdItems,

+            HashSet<int> hadPenaltyOrdrs,

+            PenaltyRuleDefinition rule,

+            Dictionary<decimal, string> slpCodeToNameMap,

+            List<PenaltyEventData> newEvents)

+        {

+            var returnProducts = returnItemsWithDevEntry

+                .Where(m => m.Price > 0 && !hadPenaltyOrdrs.Contains(m.ResolvedDevEntry))

+                .Select(x => new { x.DocEntry, x.CreateDate, x.Quantity, x.ItemCode, x.Price, U_DevEntry = x.ResolvedDevEntry })

+                .ToList();

+

+            var delivrdProductsLookUp = delivrdItems.Where(x => x.Price > 0).ToLookup(x => x.DocEntry);

+

+            foreach (var group in returnProducts.GroupBy(x => x.U_DevEntry))

+            {

+                CheckAndCreatePenaltyEvent(group, delivrdItems, returnItemsWithDevEntry, delivrdProductsLookUp, rule, slpCodeToNameMap, newEvents);

+            }

+        }

+

+        /// <summary>

+        /// 检查并创建罚息事件

+        /// </summary>

+        private void CheckAndCreatePenaltyEvent(

+            IGrouping<int, dynamic> group,

+            List<dynamic> delivrdItems,

+            List<dynamic> returnItemsWithDevEntry,

+            ILookup<int, dynamic> delivrdProductsLookUp,

+            PenaltyRuleDefinition rule,

+            Dictionary<decimal, string> slpCodeToNameMap,

+            List<PenaltyEventData> newEvents)

+        {

+            var thisOrdrReturnItems = group.GroupBy(x => x.ItemCode)

+                .Select(x => new { ItemCode = x.Key, TotalQty = x.Sum(s => s.Quantity) })

+                .ToDictionary(k => k.ItemCode, v => v.TotalQty);

+

+            var delivrdItemsInThisOrdr = delivrdProductsLookUp[group.Key]

+                .GroupBy(x => x.ItemCode)

+                .Select(x => new { ItemCode = x.Key, TotalQty = x.Sum(s => s.DelivrdQty) })

+                .ToDictionary(k => k.ItemCode, v => v.TotalQty);

+

+            if (delivrdItemsInThisOrdr.All(x => x.Value == (thisOrdrReturnItems.TryGetValue(x.Key, out var returnedQty) ? returnedQty : 0)))

+            {

+                var fixedPenaltyAmount = CalculatePenaltyAmount(delivrdItems, returnItemsWithDevEntry, group.Key);

+

+                if (!fixedPenaltyAmount.HasValue || fixedPenaltyAmount == 0)

+                    return;

+

+                var slpCode = delivrdItems.FirstOrDefault(x => x.Price == 0 && x.DocEntry == group.Key)?.SlpCode;

+

+                var PenaltyEvent = new PenaltyEventData

+                {

+                    RuleDefinitionId = rule.Id,

+                    SlpCode = slpCode,

+                    SlpName = slpCodeToNameMap[slpCode.Value],

+                    TriggerDocType = "ORDR",

+                    TriggerDocEntry = group.Key.ToString(),

+                    SEDocEntry = group.Key,

+                    PenaltyBaseAmount = fixedPenaltyAmount.Value,

+                    TriggerEventDate = group.OrderByDescending(x => x.CreateDate).First().CreateDate,

+                    PenaltyStartDate = group.OrderByDescending(x => x.CreateDate).First().CreateDate,

+                };

+                newEvents.Add(PenaltyEvent);

+            }

+        }

+

+        /// <summary>

+        /// 计算罚息金额

+        /// </summary>

+        private decimal? CalculatePenaltyAmount(List<dynamic> delivrdItems, List<dynamic> returnItemsWithDevEntry, int docEntry)

+        {

+            var returnedZeroPriceQtyByItem = returnItemsWithDevEntry

+                .Where(x => x.Price == 0 && x.ResolvedDevEntry == docEntry)

+                .GroupBy(x => x.ItemCode)

+                .ToDictionary(g => g.Key, g => g.Sum(s => s.Quantity));

+

+            return delivrdItems

+                .Where(x => x.Price == 0 && x.DocEntry == docEntry)

+                .GroupBy(x => x.ItemCode)

+                .Sum(g =>

+                {

+                    var totalDelivrdQty = g.Sum(s => s.DelivrdQty);

+                    returnedZeroPriceQtyByItem.TryGetValue(g.Key, out var returnedQty);

+                    var unreturnedQty = totalDelivrdQty - (returnedQty ?? 0);

+                    return unreturnedQty > 0 ? unreturnedQty * g.First().LastPurPrc : (decimal?)0;

+                });

         }

 

