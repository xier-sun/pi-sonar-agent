+        /// <summary>

+        /// 构建带解析 DevEntry 的退货项列表

+        /// </summary>

+        private List<dynamic> BuildReturnItemsWithDevEntry(List<dynamic> returnItems, Dictionary<int, int> resolvedDevEntryMap)

+        {

+            return returnItems.Select(x => new

+            {

+                x.DocEntry, x.U_New_ORDRID, x.ItemCode, x.Price, x.Quantity, x.StockValue, x.LastPurPrc, x.CreateDate,

+                ResolvedDevEntry = !string.IsNullOrEmpty(x.U_DevEntry)

+                    ? (int.TryParse(x.U_DevEntry, out var parsed) ? parsed : 0)

+                    : (x.DocEntry.HasValue && resolvedDevEntryMap.TryGetValue(x.DocEntry.Value, out var resolved) ? resolved : 0)

+            }).Where(x => x.ResolvedDevEntry > 0).ToList();

+        }

+

+        /// <summary>

+        /// 为单个订单计算罚息事件

+        /// </summary>

+        private PenaltyEventData CalculatePenaltyForOrder(IGrouping<int, dynamic> group, List<dynamic> delivrdItems, ILookup<int, dynamic> delivrdProductsLookUp, List<dynamic> returnItemsWithDevEntry, Dictionary<int, string> slpCodeToNameMap, string ruleId)

+        {

+            var thisOrdrReturnItems = group.GroupBy(x => x.ItemCode).Select(x => new { ItemCode = x.Key, TotalQty = x.Sum(s => s.Quantity) }).ToDictionary(k => k.ItemCode, v => v.TotalQty);

+            var delivrdItemsInThisOrdr = delivrdProductsLookUp[group.Key].GroupBy(x => x.ItemCode).Select(x => new { ItemCode = x.Key, TotalQty = x.Sum(s => s.DelivrdQty) }).ToDictionary(k => k.ItemCode, v => v.TotalQty);

+

+            // 遍历订单中所有有价物料，检查每个物料是否都已退完

+            if (!delivrdItemsInThisOrdr.All(x => x.Value == (thisOrdrReturnItems.TryGetValue(x.Key, out var returnedQty) ? returnedQty : 0)))

+            {

+                return null;

+            }

+

+            // 退货单中 Price=0 的物料，按ItemCode汇总已退数量（针对当前原始订单）

+            var returnedZeroPriceQtyByItem = returnItemsWithDevEntry

+                .Where(x => x.Price == 0 && x.ResolvedDevEntry == group.Key)

+                .GroupBy(x => x.ItemCode)

+                .ToDictionary(g => g.Key, g => g.Sum(s => s.Quantity));

+

+            // 未退的 Price=0 物料成本 = sum(未退数量 * LastPurPrc)

+            var fixedPenaltyAmount = delivrdItems

+                .Where(x => (decimal)x.Price == 0 && (int)x.DocEntry == group.Key)

+                .GroupBy(x => x.ItemCode)

+                .Sum(g =>

+                {

+                    var totalDelivrdQty = g.Sum(s => (decimal)s.DelivrdQty);

+                    returnedZeroPriceQtyByItem.TryGetValue(g.Key, out var returnedQty);

+                    var unreturnedQty = totalDelivrdQty - (returnedQty ?? 0);

+                    return unreturnedQty > 0 ? unreturnedQty * (decimal)g.First().LastPurPrc : (decimal?)0;

+                });

+

+            var slpCode = delivrdItems.FirstOrDefault(x => (decimal)x.Price == 0 && (int)x.DocEntry == group.Key)?.SlpCode;

+

+            if (!fixedPenaltyAmount.HasValue || fixedPenaltyAmount == 0)

+            {

+                return null;

+            }

+

+            return new PenaltyEventData

+            {

+                RuleDefinitionId = ruleId,

+                SlpCode = slpCode,

+                SlpName = slpCodeToNameMap[slpCode.Value],

+                TriggerDocType = "ORDR",

+                TriggerDocEntry = group.Key.ToString(),

+                SEDocEntry = group.Key,

+                PenaltyBaseAmount = fixedPenaltyAmount.Value,

+                TriggerEventDate = group.OrderByDescending(x => x.CreateDate).First().CreateDate,

+                PenaltyStartDate = group.OrderByDescending(x => x.CreateDate).First().CreateDate,

+            };

         }

 

