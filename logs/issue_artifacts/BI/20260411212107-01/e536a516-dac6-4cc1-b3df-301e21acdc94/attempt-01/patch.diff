+        /// <summary>

+        /// 逐个处理事件期间，计算逾期情况

+        /// </summary>

+        private async Task ProcessEventPeriodsAsync(

+            List<OrderEvent> events,

+            ORDR order,

+            DateTime currentPeriodStart,

+            PenaltyEvent currentEvent,

+            decimal previousOverdueAmount,

+            DateTime? generationStartDate,

+            HistoricalOverdueCalculationService.SaleOrderForOverDue saleOrderForCalc,

+            PayTermSave payTerm,

+            List<HistoricalOverdueCalculationService.DeliveryForOverDue> deliveryForCalcList,

+            List<HistoricalOverdueCalculationService.ReturnForOverDue> allReturns,

+            List<ReceiptForOrder> allReceipts,

+            List<SaleRefund> allRefunds,

+            List<HistoricalOverdueCalculationService.ClearReconForOverDue> allClearRecons,

+            SaleOrderPlugin saleOrderPlugin,

+            PenaltyRuleDefinition rule,

+            List<InterestRateTier> rateTiers,

+            OSLP slp)

+        {

+            foreach (var @event in events)

+            {

+                // 计算当前期间的结束日期

+                DateTime periodEnd = @event.EventDate;

+                bool isInterRecon = @event.EventType == OrderEventType.CanClearRecon;

+

+                // 处理当前期间的逾期情况，带事件跟踪

+                var eventTrackingResult = await ProcessOverduePeriodWithEventTracking(

+                    order,

+                    currentPeriodStart,

+                    periodEnd,

+                    currentEvent,

+                    previousOverdueAmount,

+                    generationStartDate,

+                    saleOrderForCalc,

+                    payTerm,

+                    deliveryForCalcList,

+                    allReturns,

+                    allReceipts,

+                    allRefunds,

+                    allClearRecons,

+                    saleOrderPlugin,

+                    rule,

+                    rateTiers,

+                    slp,

+                    isInterRecon

+                );

+

+                if (@event.EventType == OrderEventType.CanClearRecon)

+                {

+                    break;

+                }

+                currentEvent = eventTrackingResult.CurrentEvent;

+                previousOverdueAmount = eventTrackingResult.PreviousOverdueAmount;

+                // 更新下一个期间的起始日期为本次事件日期的第二天

+                currentPeriodStart = periodEnd.AddDays(1);

             }

