+        /// <summary>

+        /// 处理已解决的罚款事件

+        /// </summary>

+        /// <param name="resolvedEvents">已解决事件列表</param>

+        /// <param name="updateList">更新列表</param>

+        private void ProcessResolvedEvents(IEnumerable<(string EventId, string RuleDefinitionId, string? ActualResolvedDate, string? CancelReason)> resolvedEvents, List<PenaltyEvent> updateList)

+        {

+            if (!resolvedEvents.Any())

+            {

+                return;

+            }

+

+            var resolvedIds = resolvedEvents.Select(x => x.EventId).ToList();

+            var eventToResolve = UnitWork.Find<PenaltyEvent>(x => x.EventStatus == "ACTIVE" && resolvedIds.Contains(x.Id)).ToList();

+            foreach (var ent in eventToResolve)

+            {

+                var resolveInfo = resolvedEvents.FirstOrDefault(x => x.EventId == ent.Id);

+                ent.EventStatus = "RESOLVED";

+                ent.ResolvedDate = resolveInfo?.ActualResolvedDate ?? DateTime.Now;

+                updateList.Add(ent);

+            }

+        }

+

+        /// <summary>

+        /// 处理已取消的罚款事件

+        /// </summary>

+        /// <param name="canceledEvents">已取消事件列表</param>

+        /// <param name="updateList">更新列表</param>

+        private void ProcessCanceledEvents(IEnumerable<(string EventId, string RuleDefinitionId, string? ActualResolvedDate, string? CancelReason)> canceledEvents, List<PenaltyEvent> updateList)

+        {

+            if (!canceledEvents.Any())

+            {

+                return;

+            }

+

+            var canceledIds = canceledEvents.Select(x => x.EventId).ToList();

+            var eventsToCancel = UnitWork.Find<PenaltyEvent>(x => x.EventStatus == "ACTIVE" && canceledIds.Contains(x.Id)).ToList();

+            foreach (var ent in eventsToCancel)

+            {

+                var cancelInfo = canceledEvents.FirstOrDefault(x => x.EventId == ent.Id);

+                ent.EventStatus = "CANCELED";

+                ent.ResolvedDate = cancelInfo?.CanceledDate ?? DateTime.Now;

+                ent.Remark = cancelInfo?.CancelReason;

+                updateList.Add(ent);

+            }

+        }

