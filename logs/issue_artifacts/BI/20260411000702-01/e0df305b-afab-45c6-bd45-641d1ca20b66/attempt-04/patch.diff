+                        AppliedAmountFC = receipt.DocTotalFC ?? 0M

+                    };

+                    AddReceiptToDict(receiptDict, orderId, receiptForOrder);

+                }

+            }

+

+            foreach (var orderId in receiptDict.Keys.ToList())

