+        /// <summary>

+        /// 获取退货物料信息

+        /// </summary>

+        private async Task<List<dynamic>> GetReturnItemsAsync()

+        {

+            var rin1Query = UnitWork.Find<RIN1>(null);

+            var orinQuery = UnitWork.Find<ORIN>(null);

+            var oitmQuery = UnitWork.Find<OITM>(null);

+

+            var joinQuery = rin1Query

+                .Join(orinQuery, r1 => r1.DocEntry, r => r.DocEntry, (r1, r) => new { r1, r })

+                .Join(oitmQuery, x => x.r1.ItemCode, m => m.ItemCode, (x, m) => new { x.r1, x.r, m });

+

+            var filteredQuery = joinQuery

+                .Where(x => x.r.CANCELED == "N" && (x.r.U_New_ORDRID == null || x.r.U_New_ORDRID == ""));

+

+            var result = await filteredQuery

+                .Select(x => new { x.r.DocEntry, x.r.U_New_ORDRID, x.r1.ItemCode, x.r1.Price, x.r1.U_DevEntry, x.r1.Quantity, x.r1.StockValue, x.m.LastPurPrc, x.r.CreateDate, x.r1.BaseEntry, x.r1.BaseType })

+                .ToListAsync();

+

+            return result.Select(x => (dynamic)x).ToList();

+        }

+

+        /// <summary>

+        /// 获取已有罚息的订单

+        /// </summary>

+        private async Task<HashSet<int>> GetHadPenaltyOrdrsAsync()

+        {

+            var pdQuery = UnitWork.Find<PenaltyRuleDefinition>(null);

+            var peQuery = UnitWork.Find<PenaltyEvent>(null);

+

+            var joinQuery = pdQuery.Join(peQuery, pd => pd.Id, pe => pe.RuleDefinitionId, (pd, pe) => pe);

+            var filteredQuery = joinQuery.Where(x => x.RuleDefinition.PenaltyRule.RuleHandlerCode == HandlerCode);

+

+            var result = await filteredQuery.Select(x => Convert.ToInt32(x.TriggerDocEntry)).ToListAsync();

+            return result.ToHashSet();

+        }

+

+        /// <summary>

+        /// 获取已交货物料信息

+        /// </summary>

+        private async Task<List<dynamic>> GetDeliveredItemsAsync(List<int> orderDocEntries)

+        {

+            var rdr1Query = UnitWork.Find<RDR1>(null);

+            var ordrQuery = UnitWork.Find<ORDR>(null);

+            var oitmQuery = UnitWork.Find<OITM>(null);

+

+            var joinQuery = rdr1Query

+                .Join(ordrQuery, r1 => r1.DocEntry, r => r.DocEntry, (r1, r) => new { r1, r })

+                .Join(oitmQuery, x => x.r1.ItemCode, m => m.ItemCode, (x, m) => new { x.r1, x.r, m });

+

+            var filteredQuery = joinQuery.Where(x =>

+                x.r.CANCELED == "N" && x.r.DocStatus == "C" && x.r1.DelivrdQty > 0 && x.r1.LineStatus == "C" && x.r1.OpenQty == 0 && x.m.InvntItem == "Y"

+                && orderDocEntries.Contains(x.r.DocEntry));

+

+            var result = await filteredQuery

+                .Select(x => new { x.r.DocEntry, x.r1.LineNum, x.r1.ItemCode, x.r1.DelivrdQty, x.r1.Price, x.m.ManSerNum, x.m.ManBtchNum, x.m.LastPurPrc, x.r.SlpCode })

+                .ToListAsync();

+

+            return result.Select(x => (dynamic)x).ToList();

+        }

+

+        /// <summary>

+        /// 检查所有有价物料是否都已退完

+        /// </summary>

+        private bool IsAllPaidItemsReturned(Dictionary<string, decimal> delivrdItems, Dictionary<string, decimal> returnItems)

+        {

+            return delivrdItems.All(x => x.Value == (returnItems.TryGetValue(x.Key, out var returnedQty) ? returnedQty : 0));

+        }

+

+        /// <summary>

+        /// 计算罚息金额

+        /// </summary>

+        private decimal? CalculateFixedPenaltyAmount(List<dynamic> delivrdItems, int orderDocEntry, Dictionary<string, decimal> returnedZeroPriceQtyByItem)

+        {

+            return delivrdItems

+                .Where(x => (decimal)x.Price == 0 && (int)x.DocEntry == orderDocEntry)

+                .GroupBy(x => (string)x.ItemCode)

+                .Sum(g =>

+                {

+                    var totalDelivrdQty = g.Sum(s => (decimal)s.DelivrdQty);

+                    returnedZeroPriceQtyByItem.TryGetValue(g.Key, out var returnedQty);

+                    var unreturnedQty = totalDelivrdQtyQty - (returnedQty ?? 0);

+                    return unreturnedQty > 0 ? unreturnedQty * (decimal)g.First().LastPurPrc : (decimal?)0;

+                });

+        }

     }

