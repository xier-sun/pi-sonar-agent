+        /// <summary>

+        /// 检查订单是否全部退完

+        /// </summary>

+        private bool IsOrderFullyReturned(Dictionary<string, decimal> delivrdItems, Dictionary<string, decimal> returnedItems)

+        {

+            return delivrdItems.All(x => x.Value == (returnedItems.TryGetValue(x.Key, out var returnedQty) ? returnedQty : 0));

+        }

+

+        /// <summary>

+        /// 计算固定罚息金额

+        /// </summary>

+        private decimal? CalculateFixedPenaltyAmount(List<dynamic> delivrdItems, int orderDocEntry, Dictionary<string, decimal> returnedZeroPriceQtyByItem)

+        {

+            var orderItems = delivrdItems

+                .Where(x => (decimal?)x.GetType().GetProperty("Price").GetValue(x) == 0 && (int?)x.GetType().GetProperty("DocEntry").GetValue(x) == orderDocEntry)

+                .GroupBy(x => (string)x.GetType().GetProperty("ItemCode").GetValue(x));

+

+            return orderItems.Sum(g =>

+            {

+                var totalDelivrdQty = g.Sum(s => (decimal)s.GetType().GetProperty("DelivrdQty").GetValue(s));

+                returnedZeroPriceQtyByItem.TryGetValue(g.Key, out var returnedQty);

+                var unreturnedQty = totalDelivrdQty - (returnedQty ?? 0);

+                return unreturnedQty > 0 ? unreturnedQty * (decimal)g.First().GetType().GetProperty("LastPurPrc").GetValue(g.First()) : (decimal?)0;

+            });

+        }

     }

