+        /// <summary>

+        /// 处理无 U_DevEntry 物料的回溯

+        /// </summary>

+        private async Task<List<dynamic>> ProcessNullDevEntryItemsAsync(List<dynamic> returnItems)

+        {

+            // U_DevEntry 为空时，通过 RIN1 → INV1 → DLN1 回溯原始订单号

+            var nullDevEntryItems = returnItems.Where(x => string.IsNullOrEmpty(x.U_DevEntry) && x.DocEntry.HasValue && x.BaseEntry.HasValue).ToList();

+            var resolvedDevEntryMap = new Dictionary<int, int>();

+

+            if (nullDevEntryItems.Any())

+            {

+                // 提取回溯所需数据：(ORIN.DocEntry, RIN1.BaseEntry, RIN1.BaseType)

+                var traceItems = nullDevEntryItems

+                    .Select(x => (OrinDocEntry: x.DocEntry.Value, BaseEntry: x.BaseEntry.Value, BaseType: x.BaseType ?? 0))

+                    .Distinct()

+                    .ToList();

+                resolvedDevEntryMap = await ResolveOrderDocEntryFromReturnChainAsync(traceItems);

+            }

+

+            // 合并：有 U_DevEntry 的直接用，没有的用回溯结果

+            return returnItems.Select(x => new

+            {

+                x.DocEntry, x.U_New_ORDRID, x.ItemCode, x.Price, x.Quantity, x.StockValue, x.LastPurPrc, x.CreateDate,

+                ResolvedDevEntry = !string.IsNullOrEmpty(x.U_DevEntry)

+                    ? (int.TryParse(x.U_DevEntry, out var parsed) ? parsed : 0)

+                    : (x.DocEntry.HasValue && resolvedDevEntryMap.TryGetValue(x.DocEntry.Value, out var resolved) ? resolved : 0)

+            }).Where(x => x.ResolvedDevEntry > 0).ToList();

+        }

