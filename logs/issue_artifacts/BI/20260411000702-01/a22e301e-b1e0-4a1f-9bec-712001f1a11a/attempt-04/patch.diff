+        /// <summary>

+        /// 构建带已解析订单号的退货物料列表

+        /// </summary>

+        private List<dynamic> BuildReturnItemsWithDevEntry(List<dynamic> returnItems, Dictionary<int, int> resolvedDevEntryMap)

+        {

+            return returnItems.Select(x => new

+            {

+                DocEntry = ((dynamic)x).DocEntry,

+                U_New_ORDRID = ((dynamic)x).U_New_ORDRID,

+                ItemCode = ((dynamic)x).ItemCode,

+                Price = ((dynamic)x).Price,

+                Quantity = ((dynamic)x).Quantity,

+                StockValue = ((dynamic)x).StockValue,

+                LastPurPrc = ((dynamic)x).LastPurPrc,

+                CreateDate = ((dynamic)x).CreateDate,

+                ResolvedDevEntry = !string.IsNullOrEmpty(((dynamic)x).U_DevEntry)

+                    ? (int.TryParse(((dynamic)x).U_DevEntry, out var parsed) ? parsed : 0)

+                    : (((dynamic)x).DocEntry != null && resolvedDevEntryMap.TryGetValue(((dynamic)x).DocEntry, out var resolved) ? resolved : 0)

+            }).Where(x => x.ResolvedDevEntry > 0).ToList();

+        }

