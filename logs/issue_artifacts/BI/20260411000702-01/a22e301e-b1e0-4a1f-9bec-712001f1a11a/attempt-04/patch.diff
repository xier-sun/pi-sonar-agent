+        /// <summary>

+        /// 处理订单分组，生成罚息事件

+        /// </summary>

+        private PenaltyEventData ProcessOrderGroup(IGrouping<int, dynamic> group, ILookup<int, dynamic> delivrdProductsLookUp, List<dynamic> delivrdItems, List<dynamic> returnItemsWithDevEntry, PenaltyRuleDefinition rule, Dictionary<int?, string> slpCodeToNameMap)

+        {

+            var thisOrdrReturnItems = group.GroupBy(x => ((dynamic)x).ItemCode).Select(x => new { ItemCode = x.Key, TotalQty = x.Sum(s => (decimal)((dynamic)s).Quantity) }).ToDictionary(k => k.ItemCode, v => v.TotalQty);

+            var delivrdItemsInThisOrdr = delivrdProductsLookUp[group.Key].GroupBy(x => ((dynamic)x).ItemCode).Select(x => new { ItemCode = x.Key, TotalQty = x.Sum(s => (decimal)((dynamic)s).DelivrdQty) }).ToDictionary(k => k.ItemCode, v => v.TotalQty);

+

+            if (!IsOrderFullyReturned(delivrdItemsInThisOrdr, thisOrdrReturnItems))

+            {

+                return null;

+            }

+

+            var returnedZeroPriceQtyByItem = returnItemsWithDevEntry

+                .Where(x => ((dynamic)x).Price == 0 && ((dynamic)x).ResolvedDevEntry == group.Key)

+                .GroupBy(x => ((dynamic)x).ItemCode)

+                .ToDictionary(g => g.Key, g => g.Sum(s => (decimal)((dynamic)s).Quantity));

+

+            var fixedPenaltyAmount = CalculateFixedPenaltyAmount(delivrdItems, group.Key, returnedZeroPriceQtyByItem);

+

+            if (fixedPenaltyAmount == null || fixedPenaltyAmount == 0)

+            {

+                return null;

+            }

+

+            var slpCode = delivrdItems.FirstOrDefault(x => ((dynamic)x).Price == 0 && ((dynamic)x).DocEntry == group.Key)?.SlpCode;

+

+            return new PenaltyEventData

+            {

+                RuleDefinitionId = rule.Id,

+                SlpCode = slpCode,

+                SlpName = slpCodeToNameMap[slpCode.Value],

+                TriggerDocType = "ORDR",

+                TriggerDocEntry = group.Key.ToString(),

+                SEDocEntry = group.Key,

+                PenaltyBaseAmount = fixedPenaltyAmount.Value,

+                TriggerEventDate = group.OrderByDescending(x => ((dynamic)x).CreateDate).First().CreateDate,

+                PenaltyStartDate = group.OrderByDescending(x => ((dynamic)x).CreateDate).First().CreateDate,

+            };

+        }

