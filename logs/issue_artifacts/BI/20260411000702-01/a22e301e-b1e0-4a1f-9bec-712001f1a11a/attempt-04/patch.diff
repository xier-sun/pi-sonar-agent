+        private async Task<List<dynamic>> GetReturnItemsAsync()

+        {

+            return await (from r1 in UnitWork.Find<RIN1>(null)

+                          join r in UnitWork.Find<ORIN>(null) on r1.DocEntry equals r.DocEntry

+                          join m in UnitWork.Find<OITM>(null) on r1.ItemCode equals m.ItemCode

+                          where r.CANCELED == "N" && (r.U_New_ORDRID == null || r.U_New_ORDRID == "")

+                          select new { r.DocEntry, r.U_New_ORDRID, r1.ItemCode, r1.Price, r.U_DevEntry, r1.Quantity, r1.StockValue, m.LastPurPrc, r.CreateDate, r1.BaseEntry, r1.BaseType }).ToListAsync();

+        }

