+        /// <summary>

+        /// 应用逾期金额和天数的调整逻辑

+        /// </summary>

+        private static void ApplyOverdueAdjustments(SaleOrderPlugin saleOrderPlugin, HistoricalOverdueCalculationService.OverDueAmountAndDays overdueInfo)

+        {

+            if (saleOrderPlugin?.AdjustOverdueAmount.HasValue == true)

+            {

+                overdueInfo.U_Due_Amt -= saleOrderPlugin.AdjustOverdueAmount.Value;

+                if (overdueInfo.U_Due_Amt < 0) overdueInfo.U_Due_Amt = 0;

+            }

+            if (saleOrderPlugin?.AdjustOverdueDays.HasValue == true)

+            {

+                overdueInfo.U_OverDue_Days -= saleOrderPlugin.AdjustOverdueDays.Value;

+                if (overdueInfo.U_OverDue_Days < 0) overdueInfo.U_OverDue_Days = 0;

+            }

+        }

+

+        /// <summary>

+        /// 处理罚息事件变化，返回新的事件和逾期金额

+        /// </summary>

+        private async Task<(PenaltyEvent CurrentEvent, decimal PreviousOverdueAmount)> ProcessPenaltyEventChangeAsync(

+            PenaltyEvent currentEvent,

+            decimal previousOverdueAmount,

+            decimal currentOverdueAmount,

+            ORDR order,

+            DateTime currentDate,

+            PenaltyRuleDefinition rule,

+            OSLP slp,

+            List<(int EventId, DateTime ResolvedDate, string Description)> pendingEventUpdates)

+        {

+            if (currentOverdueAmount == previousOverdueAmount)

+            {

+                return (currentEvent, previousOverdueAmount);

+            }

+

+            if (currentEvent != null)

+            {

+                QueueEventUpdate(pendingEventUpdates, currentEvent, currentDate.AddDays(-1));

+            }

+

+            var newEvent = await CreateNewPenaltyEvent(order,

+                new HistoricalOverdueCalculationService.OverDueAmountAndDays { U_Due_Amt = currentOverdueAmount },

+                currentDate, rule, slp);

+

+            return (newEvent, currentOverdueAmount);

         }

 

