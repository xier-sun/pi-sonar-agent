+        /// <summary>

+        /// 应用销售订单插件调整逻辑

+        /// </summary>

+        private static void ApplySaleOrderPluginAdjustments(

+            HistoricalOverdueCalculationService.OverDueAmountAndDays overdueInfo,

+            SaleOrderPlugin saleOrderPlugin)

+        {

+            if (saleOrderPlugin == null)

+                return;

+

+            if (saleOrderPlugin.AdjustOverdueAmount.HasValue)

+            {

+                overdueInfo.U_Due_Amt -= saleOrderPlugin.AdjustOverdueAmount.Value;

+                if (overdueInfo.U_Due_Amt < 0) overdueInfo.U_Due_Amt = 0;

+            }

+

+            if (saleOrderPlugin.AdjustOverdueDays.HasValue)

+            {

+                overdueInfo.U_OverDue_Days -= saleOrderPlugin.AdjustOverdueDays.Value;

+                if (overdueInfo.U_OverDue_Days < 0) overdueInfo.U_OverDue_Days = 0;

+            }

+        }

+

+        /// <summary>

+        /// 处理单日逾期情况

+        /// </summary>

+        private async Task ProcessOverdueDayAsync(

+            ORDR order,

+            DateTime currentDate,

+            HistoricalOverdueCalculationService.OverDueAmountAndDays overdueInfo,

+            DateTime? generationStartDate,

+            SaleOrderPlugin saleOrderPlugin,

+            List<InterestRateTier> rateTiers,

+            PenaltyRuleDefinition rule,

+            OSLP slp,

+            ref PenaltyEvent currentEvent,

+            ref decimal previousOverdueAmount,

+            List<PenaltyLedger> penaltyLedgers,

+            List<(int EventId, DateTime ResolvedDate, string Description)> pendingEventUpdates,

+            int batchSize)

+        {

+            if (overdueInfo.U_Due_Amt <= 0 || overdueInfo.U_OverDue_Days <= 0)

+            {

+                ProcessNoOverdueDay(currentDate, ref currentEvent, ref previousOverdueAmount, pendingEventUpdates);

+                return;

+            }

+

+            await ProcessOverdueWithPenaltyAsync(

+                order, currentDate, overdueInfo, generationStartDate,

+                saleOrderPlugin, rateTiers, rule, slp,

+                ref currentEvent, ref previousOverdueAmount,

+                penaltyLedgers, pendingEventUpdates, batchSize);

+        }

+

+        /// <summary>

+        /// 处理无逾期情况

+        /// </summary>

+        private static void ProcessNoOverdueDay(

+            DateTime currentDate,

+            ref PenaltyEvent currentEvent,

+            ref decimal previousOverdueAmount,

+            List<(int EventId, DateTime ResolvedDate, string Description)> pendingEventUpdates)

+        {

+            if (currentEvent != null)

+            {

+                QueueEventUpdate(pendingEventUpdates, currentEvent, currentDate.AddDays(-1));

+                currentEvent = null;

+                previousOverdueAmount = 0;

+            }

+        }

+

+        /// <summary>

+        /// 处理有逾期但无罚息情况

+        /// </summary>

+        private static void ProcessOverdueNoPenaltyDay(

+            DateTime currentDate,

+            ref PenaltyEvent currentEvent,

+            ref decimal previousOverdueAmount,

+            List<(int EventId, DateTime ResolvedDate, string Description)> pendingEventUpdates)

+        {

+            if (currentEvent != null)

+            {

+                QueueEventUpdate(pendingEventUpdates, currentEvent, currentDate.AddDays(-1));

+                currentEvent = null;

+                previousOverdueAmount = 0;

+            }

+        }

+

+        /// <summary>

+        /// 处理有逾期且有罚息情况

+        /// </summary>

+        private async Task ProcessOverdueWithPenaltyAsync(

+            ORDR order,

+            DateTime currentDate,

+            HistoricalOverdueCalculationService.OverDueAmountAndDays overdueInfo,

+            DateTime? generationStartDate,

+            SaleOrderPlugin saleOrderPlugin,

+            List<InterestRateTier> rateTiers,

+            PenaltyRuleDefinition rule,

+            OSLP slp,

+            ref PenaltyEvent currentEvent,

+            ref decimal previousOverdueAmount,

+            List<PenaltyLedger> penaltyLedgers,

+            List<(int EventId, DateTime ResolvedDate, string Description)> pendingEventUpdates,

+            int batchSize)

+        {

+            var (penaltyAmount, dailyRate) = CalculatePenaltyAmount(overdueInfo, saleOrderPlugin, rateTiers);

+

+            if (penaltyAmount <= 0)

+            {

+                ProcessOverdueNoPenaltyDay(currentDate, ref currentEvent, ref previousOverdueAmount, pendingEventUpdates);

+                return;

+            }

+

+            await ProcessPenaltyGenerationAsync(

+                order, currentDate, overdueInfo, generationStartDate,

+                penaltyAmount, dailyRate, rule, slp,

+                ref currentEvent, ref previousOverdueAmount,

+                penaltyLedgers, pendingEventUpdates, batchSize);

+        }

+

+        /// <summary>

+        /// 处理罚息生成逻辑

+        /// </summary>

+        private async Task ProcessPenaltyGenerationAsync(

+            ORDR order,

+            DateTime currentDate,

+            HistoricalOverdueCalculationService.OverDueAmountAndDays overdueInfo,

+            DateTime? generationStartDate,

+            decimal penaltyAmount,

+            decimal dailyRate,

+            PenaltyRuleDefinition rule,

+            OSLP slp,

+            ref PenaltyEvent currentEvent,

+            ref decimal previousOverdueAmount,

+            List<PenaltyLedger> penaltyLedgers,

+            List<(int EventId, DateTime ResolvedDate, string Description)> pendingEventUpdates,

+            int batchSize)

+        {

+            if (overdueInfo.U_Due_Amt != previousOverdueAmount)

+            {

+                if (currentEvent != null)

+                {

+                    QueueEventUpdate(pendingEventUpdates, currentEvent, currentDate.AddDays(-1));

+                }

+

+                currentEvent = await CreateNewPenaltyEvent(order, overdueInfo, currentDate, rule, slp);

+                previousOverdueAmount = overdueInfo.U_Due_Amt;

+            }

+

+            if (currentEvent != null && (!generationStartDate.HasValue || currentDate >= generationStartDate.Value))

+            {

+                CreateDailyPenaltyLedgerEntry(order, overdueInfo, penaltyAmount, currentDate, currentEvent, dailyRate, slp, ref penaltyLedgers);

+

+                if (penaltyLedgers.Count >= batchSize)

+                {

+                    await UnitWork.BatchAddAsync<PenaltyLedger, int>(penaltyLedgers.ToArray());

+                    await UnitWork.SaveAsync();

+                    penaltyLedgers.Clear();

+                }

+            }

+        }

