         /// <summary>

+        /// 获取批量数据上下文

+        /// </summary>

+        private BatchDataContext GetBatchDataContext(

+            ORDR order,

+            Dictionary<int, HistoricalOverdueCalculationService.SaleOrderForOverDue> batchSaleOrders,

+            Dictionary<int, PayTermSave> batchPayTerms,

+            Dictionary<int, List<HistoricalOverdueCalculationService.DeliveryForOverDue>> batchDeliveries,

+            Dictionary<int, List<ReceiptForOrder>> batchReceipts,

+            Dictionary<int, List<HistoricalOverdueCalculationService.ReturnForOverDue>> batchReturns,

+            Dictionary<int, List<SaleRefund>> batchRefunds,

+            Dictionary<int, List<HistoricalOverdueCalculationService.ClearReconForOverDue>> batchClearRecons)

+        {

+            var context = new BatchDataContext();

+

+            // 1. 获取订单详情

+            if(!batchSaleOrders.TryGetValue(order.DocEntry, out var saleOrderForCalc))

+            {

+                context.SaleOrderForCalc = null;

+                context.SaleOrderFound = false;

+            }

+            else

+            {

+                context.SaleOrderForCalc = saleOrderForCalc;

+                context.SaleOrderFound = true;

+            }

+

+            // 2. 获取付款条款

+            if (context.SaleOrderForCalc != null && context.SaleOrderForCalc.GroupNum.HasValue)

+            {

+                batchPayTerms?.TryGetValue(context.SaleOrderForCalc.GroupNum.Value, out context.PayTerm);

+            }

+

+            // 3. 获取发货记录

+            if (!batchDeliveries.TryGetValue(order.DocEntry, out

+                List<HistoricalOverdueCalculationService.DeliveryForOverDue> deliveryForCalcList))

+            {

+                deliveryForCalcList = new List<HistoricalOverdueCalculationService.DeliveryForOverDue>();

+            }

+            context.DeliveryForCalcList = deliveryForCalcList;

+

+            // 4. 获取收款记录

+            if (!batchReceipts.TryGetValue(order.DocEntry, out

+                List<ReceiptForOrder> allReceipts))

+            {

+                allReceipts = new List<ReceiptForOrder>();

+            }

+            context.AllReceipts = allReceipts;

+

+            // 5. 获取退货记录

+            if (!batchReturns.TryGetValue(order.DocEntry, out

+                List<HistoricalOverdueCalculationService.ReturnForOverDue> allReturns))

+            {

+                allReturns = new List<HistoricalOverdueCalculationService.ReturnForOverDue>();

+            }

+            context.AllReturns = allReturns;

+

+            if (batchRefunds == null || !batchRefunds.TryGetValue(order.DocEntry, out

+                List<SaleRefund> allRefunds))

+            {

+                allRefunds = new List<SaleRefund>();

+            }

+            context.AllRefunds = allRefunds;

+

+            // 6.获取清账记录

+            if (!batchClearRecons.TryGetValue(order.DocEntry, out

+                List<HistoricalOverdueCalculationService.ClearReconForOverDue> allClearRecons))

+            {

+                allClearRecons = new List<HistoricalOverdueCalculationService.ClearReconForOverDue>();

+            }

+            context.AllClearRecons = allClearRecons;

+

+            return context;

+        }

+

+        /// <summary>

+        /// 批量数据上下文

+        /// </summary>

+        private class BatchDataContext

+        {

+            public HistoricalOverdueCalculationService.SaleOrderForOverDue SaleOrderForCalc { get; set; }

+            public bool SaleOrderFound { get; set; }

+            public PayTermSave PayTerm { get; set; }

+            public List<HistoricalOverdueCalculationService.DeliveryForOverDue> DeliveryForCalcList { get; set; }

+            public List<ReceiptForOrder> AllReceipts { get; set; }

+            public List<HistoricalOverdueCalculationService.ReturnForOverDue> AllReturns { get; set; }

+            public List<SaleRefund> AllRefunds { get; set; }

+            public List<HistoricalOverdueCalculationService.ClearReconForOverDue> AllClearRecons { get; set; }

+        }

+

