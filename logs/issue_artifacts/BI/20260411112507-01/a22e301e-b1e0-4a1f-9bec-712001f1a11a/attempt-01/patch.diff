         /// <summary>

+        /// 获取退货物料数据

+        /// </summary>

+        private async Task<List<dynamic>> GetReturnItemsAsync()

+        {

+            return await (from r1 in UnitWork.Find<RIN1>(null)

+                          join r in UnitWork.Find<ORIN>(null) on r1.DocEntry equals r.DocEntry

+                          join m in UnitWork.Find<OITM>(null) on r1.ItemCode equals m.ItemCode

+                          where r.CANCELED == "N" && (r.U_New_ORDRID == null || r.U_New_ORDRID == "")

+                          select new { r.DocEntry, r.U_New_ORDRID, r1.ItemCode, r1.Price, r.U_DevEntry, r1.Quantity, r1.StockValue, m.LastPurPrc, r.CreateDate, r1.BaseEntry, r1.BaseType }).ToListAsync();

+        }

+

+        /// <summary>

+        /// 过滤并合并退货数据，关联原始订单号

+        /// </summary>

+        private List<dynamic> FilterReturnItemsWithDevEntry(IEnumerable<dynamic> returnItems, Dictionary<int, int> resolvedDevEntryMap)

+        {

+            return returnItems.Select(x => new

+            {

+                DocEntry = ((dynamic)x).DocEntry,

+                U_New_ORDRID = ((dynamic)x).U_New_ORDRID,

+                ItemCode = ((dynamic)x).ItemCode,

+                Price = ((dynamic)x).Price,

+                Quantity = ((dynamic)x).Quantity,

+                StockValue = ((dynamic)x).StockValue,

+                LastPurPrc = ((dynamic)x).LastPurPrc,

+                CreateDate = ((dynamic)x).CreateDate,

+                ResolvedDevEntry = !string.IsNullOrEmpty(((dynamic)x).U_DevEntry)

+                    ? (int.TryParse(((dynamic)x).U_DevEntry, out var parsed) ? parsed : 0)

+                    : (((dynamic)x).DocEntry != null && resolvedDevEntryMap.TryGetValue(((dynamic)x).DocEntry.Value, out var resolved) ? resolved : 0))

+            }).Where(x => x.ResolvedDevEntry > 0).ToList();

+        }

+

+        /// <summary>

+        /// 检查订单中所有有价物料是否都已退完

+        /// </summary>

+        private bool AreAllPriceItemsReturned(Dictionary<string, decimal> delivrdItemsInThisOrdr, Dictionary<string, decimal> thisOrdrReturnItems)

+        {

+            return delivrdItemsInThisOrdr.All(x => x.Value == (thisOrdrReturnItems.TryGetValue(x.Key, out var returnedQty) ? returnedQty : 0));

+        }

+

+        /// <summary>

+        /// 计算未退的零价物料罚息金额

+        /// </summary>

+        private decimal? CalculateUnreturnedZeroPricePenaltyAmount(IEnumerable<dynamic> delivrdItems, int docEntry, Dictionary<string, decimal> returnedZeroPriceQtyByItem)

+        {

+            return delivrdItems

+                .Where(x => ((dynamic)x).Price == 0 && ((dynamic)x).DocEntry == docEntry)

+                .GroupBy(x => ((dynamic)x).ItemCode)

+                .Sum(g =>

+                {

+                    var totalDelivrdQty = g.Sum(s => ((dynamic)s).DelivrdQty);

+                    returnedZeroPriceQtyByItem.TryGetValue(g.Key, out var returnedQty);

+                    var unreturnedQty = totalDelivrdQty - (returnedQty ?? 0);

+                    return unreturnedQty > 0 ? unreturnedQty * ((dynamic)g.First().LastPurPrc) : (decimal?)0;

+                });

+        }

