+        /// <summary>

+        /// 合并有 U_DevEntry 的项和回溯结果

+        /// </summary>

+        private IEnumerable<dynamic> MergeDevEntries(dynamic returnItems, Dictionary<int, int> resolvedDevEntryMap)

+        {

+            return ((IEnumerable<dynamic>)returnItems).Select(x => new

+            {

+                x.DocEntry,

+                x.U_New_ORDRID,

+                x.ItemCode,

+                x.Price,

+                x.Quantity,

+                x.StockValue,

+                x.LastPurPrc,

+                x.CreateDate,

+                ResolvedDevEntry = !string.IsNullOrEmpty(x.U_DevEntry)

+                    ? (int.TryParse(x.U_DevEntry, out var parsed) ? parsed : 0)

+                    : (x.DocEntry != null && resolvedDevEntryMap.TryGetValue((int)x.DocEntry, out var resolved) ? resolved : 0)

+            }).Where(x => x.ResolvedDevEntry > 0);

+        }

+

+        /// <summary>

+        /// 检查所有有价物料是否都已退完

+        /// </summary>

+        private bool AreAllPaidItemsReturned(Dictionary<string, decimal> returnedItems, Dictionary<string, decimal> delivrdItems)

+        {

+            return delivrdItems.All(x => x.Value == (returnedItems.TryGetValue(x.Key, out var returnedQty) ? returnedQty : 0));

+        }

+

+        /// <summary>

+        /// 计算固定罚息金额

+        /// </summary>

+        private (decimal? Amount, int? SlpCode) CalculateFixedPenaltyAmount(int ordrDocEntry, dynamic delivrdItems, Dictionary<string, decimal> returnedZeroPriceQtyByItem)

+        {

+            var fixedPenaltyAmount = ((IEnumerable<dynamic>)delivrdItems)

+                .Where(x => x.Price == 0 && x.DocEntry == ordrDocEntry)

+                .GroupBy(x => x.ItemCode)

+                .Sum(g =>

+                {

+                    var totalDelivrdQty = g.Sum(s => s.DelivrdQty);

+                    returnedZeroPriceQtyByItem.TryGetValue((string)g.Key, out var returnedQty);

+                    var unreturnedQty = totalDelivrdQty - (returnedQty ?? 0);

+                    return unreturnedQty > 0 ? unreturnedQty * g.First().LastPurPrc : (decimal?)0;

+                });

+

+            var slpCode = ((IEnumerable<dynamic>)delivrdItems)

+                .FirstOrDefault(x => x.Price == 0 && x.DocEntry == ordrDocEntry)?.SlpCode;

+

+            return (fixedPenaltyAmount, slpCode);

         }

 

