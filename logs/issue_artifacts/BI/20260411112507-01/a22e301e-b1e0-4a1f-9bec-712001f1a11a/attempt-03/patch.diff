         /// <summary>

+        /// 计算固定罚息金额

+        /// </summary>

+        private decimal? CalculateFixedPenaltyAmount(

+            int ordrDocEntry,

+            List<dynamic> delivrdItems,

+            Dictionary<string, decimal> returnedZeroPriceQtyByItem)

+        {

+            return delivrdItems

+                .Where(x => x.Price == 0 && x.DocEntry == ordrDocEntry)

+                .GroupBy(x => x.ItemCode)

+                .Sum(g =>

+                {

+                    var totalDelivrdQty = g.Sum(s => s.DelivrdQty);

+                    returnedZeroPriceQtyByItem.TryGetValue(g.Key, out var returnedQty);

+                    var unreturnedQty = totalDelivrdQty - returnedQty;

+                    return unreturnedQty > 0 ? unreturnedQty * g.First().LastPurPrc : (decimal?)0;

+                });

+        }

