+        /// <summary>

+        /// 解析退货物料的原始订单号

+        /// </summary>

+        private List<dynamic> ResolveDevEntryFromItems(List<dynamic> returnItems, Dictionary<int, int> resolvedDevEntryMap)

+        {

+            return returnItems.Select(x => new

+            {

+                x.DocEntry,

+                x.U_New_ORDRID,

+                x.ItemCode,

+                x.Price,

+                x.Quantity,

+                x.StockValue,

+                x.LastPurPrc,

+                x.CreateDate,

+                ResolvedDevEntry = GetResolvedDevEntry(x, resolvedDevEntryMap)

+            }).Where(x => x.ResolvedDevEntry > 0).ToList();

+        }

+

+        /// <summary>

+        /// 获取解析后的原始订单号

+        /// </summary>

+        private int GetResolvedDevEntry(dynamic x, Dictionary<int, int> resolvedDevEntryMap)

+        {

+            if (!string.IsNullOrEmpty(x.U_DevEntry))

+            {

+                if (int.TryParse(x.U_DevEntry, out var parsed))

+                {

+                    return parsed;

+                }

+                return 0;

+            }

+

+            if (x.DocEntry.HasValue && resolvedDevEntryMap.TryGetValue(x.DocEntry.Value, out var resolved))

+            {

+                return resolved;

+            }

+

+            return 0;

+        }

+

+        /// <summary>

+        /// 计算单个订单组的罚息事件

+        /// </summary>

+        private PenaltyEventData CalculatePenaltyForOrderGroup(

+            IGrouping<int, dynamic> group,

+            string ruleId,

+            int docEntry,

+            List<dynamic> delivrdItems,

+            List<dynamic> returnItemsWithDevEntry,

+            Dictionary<string, string> slpCodeToNameMap)

+        {

+            // 退货单中 Price=0 的物料，按ItemCode汇总已退数量（针对当前原始订单）

+            var returnedZeroPriceQtyByItem = returnItemsWithDevEntry

+                .Where(x => x.Price == 0 && x.ResolvedDevEntry == docEntry)

+                .GroupBy(x => x.ItemCode)

+                .ToDictionary(g => g.Key, g => g.Sum(s => s.Quantity));

+

+            // 未退的 Price=0 物料成本 = sum(未退数量 * LastPurPrc)

+            var fixedPenaltyAmount = delivrdItems

+                .Where(x => x.Price == 0 && x.DocEntry == docEntry)

+                .GroupBy(x => x.ItemCode)

+                .Sum(g =>

+                {

+                    var totalDelivrdQty = g.Sum(s => s.DelivrdQty);

+                    returnedZeroPriceQtyByItem.TryGetValue(g.Key, out var returnedQty);

+                    var unreturnedQty = totalDelivrdQty - (returnedQty ?? 0);

+                    return unreturnedQty > 0 ? unreturnedQty * g.First().LastPurPrc : (decimal?)0;

+                });

+

+            var slpCode = delivrdItems.FirstOrDefault(x => x.Price == 0 && x.DocEntry == docEntry)?.SlpCode;

+

+            if (fixedPenaltyAmount.HasValue && fixedPenaltyAmount != 0 && slpCode != null)

+            {

+                var latestDate = group.OrderByDescending(x => x.CreateDate).First().CreateDate;

+                return new PenaltyEventData

+                {

+                    RuleDefinitionId = ruleId,

+                    SlpCode = slpCode,

+                    SlpName = slpCodeToNameMap[slpCode.Value],

+                    TriggerDocType = "ORDR",

+                    TriggerDocEntry = docEntry.ToString(),

+                    SEDocEntry = docEntry,

+                    PenaltyBaseAmount = fixedPenaltyAmount.Value,

+                    TriggerEventDate = latestDate,

+                    PenaltyStartDate = latestDate

+                };

+            }

+

+            return null;

+        }

     }

