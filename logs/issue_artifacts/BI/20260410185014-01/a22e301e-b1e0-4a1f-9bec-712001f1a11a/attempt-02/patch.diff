+        /// <summary>

+        /// 检查订单中所有有价物料是否已全部退完

+        /// </summary>

+        private static bool AreAllPriceItemsReturned(Dictionary<string, decimal> delivrdItemsInThisOrdr, Dictionary<string, decimal> thisOrdrReturnItems)

+        {

+            foreach (var item in delivrdItemsInThisOrdr)

+            {

+                decimal returnedQty = 0;

+                if (thisOrdrReturnItems.TryGetValue(item.Key, out returnedQty))

+                {

+                    if (item.Value != returnedQty)

+                    {

+                        return false;

+                    }

+                }

+                else

+                {

+                    return false;

+                }

+            }

+            return true;

+        }

+

+        /// <summary>

+        /// 计算零价格物料的罚息金额

+        /// </summary>

+        private static decimal? CalculateZeroPricePenalty(

+            List<dynamic> delivrdItems,

+            List<dynamic> returnItemsWithDevEntry,

+            int orderDocEntry)

+        {

+            var penaltyAmount = 0m;

+            var returnedZeroPriceQtyByItem = returnItemsWithDevEntry

+                .Where(x => (decimal)x.Price == 0 && (int)x.ResolvedDevEntry == orderDocEntry)

+                .GroupBy(x => x.ItemCode)

+                .ToDictionary(g => g.Key, g => g.Sum(s => (decimal)s.Quantity));

+

+            var zeroPriceDelivrdItems = delivrdItems

+                .Where(x => (decimal)x.Price == 0 && (int)x.DocEntry == orderDocEntry)

+                .GroupBy(x => x.ItemCode);

+

+            foreach (var group in zeroPriceDelivrdItems)

+            {

+                var totalDelivrdQty = group.Sum(s => (decimal)s.DelivrdQty);

+                decimal? returnedQty = null;

+                if (returnedZeroPriceQtyByItem.TryGetValue(group.Key, out var qty))

+                {

+                    returnedQty = qty;

+                }

+                var unreturnedQty = totalDelivrdQty - (returnedQty ?? 0);

+                if (unreturnedQty > 0)

+                {

+                    penaltyAmount += unreturnedQty * (decimal)group.First().LastPurPrc;

+                }

+            }

+

+            return penaltyAmount > 0 ? penaltyAmount : (decimal?)null;

         }

 

