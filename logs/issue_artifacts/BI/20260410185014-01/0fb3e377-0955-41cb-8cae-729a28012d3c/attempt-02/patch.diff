+        /// <summary>

+        /// 构建自动清账条件

+        /// </summary>

+        /// <param name="ordr"></param>

+        /// <param name="ordrStat"></param>

+        /// <returns></returns>

+        private AutoPluginCondition BuildAutoPluginCondition(ORDR ordr, OrdrStat ordrStat)

+        {

+            var condition = new AutoPluginCondition();

+

+            // 已收全款，但是应收余额大于0自动可清单

+            if (ordrStat.U_ReceivePayStatus != 1)

+            {

+                return condition;

+            }

+

+            // 计算人民币余额（用于100元判断）

+            condition.DocTotalRMB = ordr.DocTotal.Value;

+            if (condition.DocTotalRMB <= 0)

+            {

+                return condition;

+            }

+

+            var receiptAmountRMB = ordr.U_DocRCTAmount ?? 0M;

+            var uRefundAmtRMB = ordrStat.U_Refund_Amt;

+

+            if (ordr.DocStatus == "C")

+            {

+                condition.BalanceRMB = (ordrStat.U_Delivery_TotalAmt ?? 0) - (receiptAmountRMB - uRefundAmtRMB);

+            }

+            else

+            {

+                condition.BalanceRMB = condition.DocTotalRMB - (receiptAmountRMB - uRefundAmtRMB);

+            }

+

+            // 计算回款率（区分人民币和外币）

+            if (ordr.DocCur == FinanceConsts.RMB)

+            {

+                // 人民币订单：使用人民币计算回款率

+                condition.PaymentRate = (receiptAmountRMB - uRefundAmtRMB) / condition.DocTotalRMB;

+                if (condition.BalanceRMB <= 0)

+                {

+                    return condition;

+                }

+            }

+            else

+            {

+                // 外币订单：使用外币计算回款率

+                var docTotalFC = ordr.DocTotalFC.Value;

+                var receiptAmountFC = ordrStat.U_Receipt_TotalAmtFC ?? 0M;

+                var uRefundAmtFC = ordrStat.U_Refund_AmtFC;

+                if (docTotalFC <= 0)

+                {

+                    return condition;

+                }

+                if (docTotalFC - (receiptAmountFC - uRefundAmtFC) <= 0)

+                {

+                    return condition;

+                }

+                condition.PaymentRate = (receiptAmountFC - uRefundAmtFC) / docTotalFC;

+            }

+

+            // 外币汇率差自动清账条件：

+            // 1. 已收完款（订单状态为已收全款）

+            // 2. 未收完款但总回款率达98% & 人民币余额<100元

+            condition.ShouldProcess = ordrStat.U_ReceivePayStatus == 1 ||

+                                      (condition.PaymentRate >= 0.98m && Math.Abs(condition.BalanceRMB) < 100m);

+

+            return condition;

+        }

+

+        /// <summary>

+        /// 处理订单清账

+        /// </summary>

+        /// <param name="orderId"></param>

+        /// <param name="condition"></param>

+        /// <returns></returns>

+        private async Task ProcessAutoPlugin(int orderId, AutoPluginCondition condition)

+        {

+            var plugin = await UnitWork.FindSingleAsync<SaleOrderPlugin>(r => orderId == r.DocEntry && r.SboId == SboIdEnums.neware_201304);

+            if (plugin?.CanInterRecon == InterReconEnums.Permit)

+            {

+                return;

+            }

+

+            // 设置或更新可清单标志

+            if (plugin == null)

+            {

+                await UnitWork.AddAsync<SaleOrderPlugin, int>(new SaleOrderPlugin()

+                {

+                    DocEntry = orderId,

+                    SboId = SboIdEnums.neware_201304,

+                    CanInterRecon = InterReconEnums.Permit,

+                    UserID = Define.ADMINID,

+                });

+                await UpdateCrmSaleOrderCanInterRecon(orderId, true);

+            }

+            else if (plugin.CanInterRecon == InterReconEnums.Forbid)

+            {

+                plugin.CanInterRecon = InterReconEnums.Permit;

+                plugin.UpdateDate = DateTime.Now;

+                plugin.UserID = Define.ADMINID;

+                await UnitWork.UpdateAsync(plugin);

+                await UpdateCrmSaleOrderCanInterRecon(plugin.DocEntry, true);

+            }

+

+            // 添加备注

+            await UnitWork.AddAsync<SaleOrdrRemark, int>(new SaleOrdrRemark()

+            {

+                Remark = $"【{EnumUtility.GetDescription(InterReconEnums.Permit)}】系统自动清账",

+                DocEntry = orderId,

+                SboId = SboIdEnums.neware_201304,

+                UserID = Define.ADMINID,

+            });

+            await UnitWork.SaveAsync();

+        }

