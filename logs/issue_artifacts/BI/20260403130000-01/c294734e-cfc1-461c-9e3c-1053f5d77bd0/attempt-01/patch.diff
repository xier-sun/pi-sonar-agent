+        private void ResetConfirmedStatusIfNeeded(UserSocialsecurity record, ProcessSocialsecurityRecordParams p)

+        {

+            if (!p.HasSubstantiveChange)

+            {

+                return;

+            }

+

+            if (p.Type == SocialsecurityTypeEnums.Socialsecurity)

+            {

+                if (record.SIsPay == "Y")

+                {

+                    record.SIsPay = "N";

+                }

+                if (record.SIsEnd == "Y")

+                {

+                    record.SIsEnd = "N";

+                }

+            }

+            else if (p.Type == SocialsecurityTypeEnums.Accumulationfunds)

+            {

