+        /// <summary>

+        /// 构建社保预览处理参数

+        /// </summary>

+        private ProcessSocialsecurityRecordParams BuildSocialSecurityPreviewParams(

+            UpdateSocialFundRequest updateRequest,

+            List<UserSocialsecurity> previewSecurities,

+            string systemUserId,

+            string account,

+            string userName,

+            User loginUser,

+            List<UserSocialsecurity> previewAdds,

+            List<UserSocialsecurity> previewUpdates,

+            List<UserSocialsecurity> previewDeletes)

+        {

+            return new ProcessSocialsecurityRecordParams

+            {

+                CurrentSecurities = previewSecurities,

+                Type = SocialsecurityTypeEnums.Socialsecurity,

+                UpdateId = updateRequest.UpdateId,

+                UserId = systemUserId,

+                Account = account,

+                Name = userName,

+                UpdateAction = (ss) => UpdateSocialSecurityFields(ss, updateRequest),

+                CreateCondition = () => ShouldCreateSocialSecurityRecord(updateRequest),

+                CreateAction = (ss) => CreateSocialSecurityFields(ss, updateRequest),

+                AddSocialsecurityList = previewAdds,

+                UpdateSocialsecurityList = previewUpdates,

+                DelSocialsecurityList = previewDeletes,

+                LoginUser = loginUser,

+                OperationScene = PaymentOrRefundEnums.Payment,

+                HasSubstantiveChange = false

+            };

+        }

+

+        /// <summary>

+        /// 构建公积金预览处理参数

+        /// </summary>

+        private ProcessSocialsecurityRecordParams BuildAccumulationFundPreviewParams(

+            UpdateSocialFundRequest updateRequest,

+            List<UserSocialsecurity> previewSecurities,

+            string systemUserId,

+            string account,

+            string userName,

+            User loginUser,

+            List<UserSocialsecurity> previewAdds,

+            List<UserSocialsecurity> previewUpdates,

+            List<UserSocialsecurity> previewDeletes)

+        {

+            return new ProcessSocialsecurityRecordParams

+            {

+                CurrentSecurities = previewSecurities,

+                Type = SocialsecurityTypeEnums.Accumulationfunds,

+                UpdateId = updateRequest.UpdateId,

+                UserId = systemUserId,

+                Account = account,

+                Name = userName,

+                UpdateAction = (af) => UpdateAccumulationFundFields(af, updateRequest),

+                CreateCondition = () => ShouldCreateAccumulationFundRecord(updateRequest),

+                CreateAction = (af) => CreateAccumulationFundFields(af, updateRequest),

+                AddSocialsecurityList = previewAdds,

+                UpdateSocialsecurityList = previewUpdates,

+                DelSocialsecurityList = previewDeletes,

+                LoginUser = loginUser,

+                OperationScene = PaymentOrRefundEnums.Payment,

+                HasSubstantiveChange = false

+            };

+        }

+

+        /// <summary>

+        /// 更新社保字段

+        /// </summary>

+        private void UpdateSocialSecurityFields(UserSocialsecurity ss, UpdateSocialFundRequest updateRequest)

+        {

+            if (!string.IsNullOrEmpty(updateRequest.SocialSecurityAccount))

+                ss.SocialsecurityAccount = updateRequest.SocialSecurityAccount;

+            if (updateRequest.IsInternship && updateRequest.BeginPaymentTime.HasValue)

+                ss.SBeginPaymentTime = updateRequest.BeginPaymentTime;

+            if (updateRequest?.Remark != null)

+                ss.Remark = updateRequest.Remark;

+        }

+

+        /// <summary>

+        /// 判断是否需要创建社保记录

+        /// </summary>

+        private bool ShouldCreateSocialSecurityRecord(UpdateSocialFundRequest updateRequest)

+        {

+            return !string.IsNullOrEmpty(updateRequest.SocialSecurityAccount) ||

+                   (updateRequest.IsInternship && updateRequest.BeginPaymentTime.HasValue);

+        }

+

+        /// <summary>

+        /// 创建社保字段

+        /// </summary>

+        private void CreateSocialSecurityFields(UserSocialsecurity ss, UpdateSocialFundRequest updateRequest)

+        {

+            ss.SocialsecurityAccount = updateRequest.SocialSecurityAccount ?? "";

+            ss.SBeginPaymentTime = updateRequest.IsInternship ? updateRequest.BeginPaymentTime : null;

+            ss.Remark = updateRequest.Remark ?? "";

+        }

+

+        /// <summary>

+        /// 更新公积金字段

