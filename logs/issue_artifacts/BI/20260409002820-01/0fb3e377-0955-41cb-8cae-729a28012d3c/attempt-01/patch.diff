+        private async Task<bool> ValidateAndCalculateAsync(int orderId, ORDR ordr, OrdrStat ordrStat, out decimal balanceRMB, out decimal paymentRate)

+        {

+            balanceRMB = 0;

+            paymentRate = 0;

+

+            if (ordrStat.U_ReceivePayStatus != 1)

+            {

+                return false;

+            }

+

+            var docTotalRMB = ordr.DocTotal.Value;

+            if (docTotalRMB <= 0)

+                return false;

+

+            var receiptAmountRMB = ordr.U_DocRCTAmount ?? 0M;

+            var uRefundAmtRMB = ordrStat.U_Refund_Amt;

+

+            balanceRMB = CalculateBalanceRMB(ordr, ordrStat, docTotalRMB, receiptAmountRMB, uRefundAmtRMB);

+            paymentRate = CalculatePaymentRate(ordr, ordrStat, docTotalRMB, receiptAmountRMB, uRefundAmtRMB, balanceRMB);

+

+            if (paymentRate < 0)

+                return false;

+

+            bool shouldPlugin = ordrStat.U_ReceivePayStatus == 1 ||

+                               (paymentRate >= 0.98m && Math.Abs(balanceRMB) < 100m);

+

+            return shouldPlugin;

+        }

+

+        private decimal CalculateBalanceRMB(ORDR ordr, OrdrStat ordrStat, decimal docTotalRMB, decimal receiptAmountRMB, decimal uRefundAmtRMB)

+        {

+            if (ordr.DocStatus == "C")

+            {

+                return (ordrStat.U_Delivery_TotalAmt ?? 0) - (receiptAmountRMB - uRefundAmtRMB);

+            }

+            else

+            {

+                return docTotalRMB - (receiptAmountRMB - uRefundAmtRMB);

+            }

+        }

+

+        private decimal CalculatePaymentRate(ORDR ordr, OrdrStat ordrStat, decimal docTotalRMB, decimal receiptAmountRMB, decimal uRefundAmtRMB, decimal balanceRMB)

+        {

+            if (ordr.DocCur == FinanceConsts.RMB)

+            {

+                if (balanceRMB <= 0)

+                {

+                    return -1;

+                }

+                return (receiptAmountRMB - uRefundAmtRMB) / docTotalRMB;

+            }

+            else

+            {

+                var docTotalFC = ordr.DocTotalFC.Value;

+                var receiptAmountFC = ordrStat.U_Receipt_TotalAmtFC ?? 0M;

+                var uRefundAmtFC = ordrStat.U_Refund_AmtFC;

+

+                if (docTotalFC <= 0)

+                    return -1;

+                if (docTotalFC - (receiptAmountFC - uRefundAmtFC) <= 0)

+                {

+                    return -1;

+                }

+                return (receiptAmountFC - uRefundAmtFC) / docTotalFC;

+            }

+        }

+

+        private async Task ProcessPluginAsync(int orderId, ORDR ordr, OrdrStat ordrStat, decimal balanceRMB, decimal paymentRate)

+        {

+            LogHelper.Info(string.Format("自动可清单：销售单号：{0}；订单金额(人民币){1}；余额(人民币){2}；回款率{3}%",

+                orderId, ordr.DocTotal.Value, balanceRMB, paymentRate * 100), nameof(FinanceHanlerApp), nameof(AutoPlugin));

+

+            var plugin = await UnitWork.FindSingleAsync<SaleOrderPlugin>(r => orderId == r.DocEntry && r.SboId == SboIdEnums.neware_201304);

+            if (plugin?.CanInterRecon == InterReconEnums.Permit)

+            {

+                return;

+            }

+

+            await HandlePluginUpdateAsync(orderId, plugin);

+            await AddPluginRemarkAsync(orderId);

+            await UnitWork.SaveAsync();

+        }

+

+        private async Task HandlePluginUpdateAsync(int orderId, SaleOrderPlugin plugin)

+        {

+            if (plugin == null)

+            {

+                var newPlugin = new SaleOrderPlugin()

+                {

+                    DocEntry = orderId,

+                    SboId = SboIdEnums.neware_201304,

+                    CanInterRecon = InterReconEnums.Permit,

+                    UserID = Define.ADMINID,

+                };

+                await UnitWork.AddAsync<SaleOrderPlugin, int>(newPlugin);

+                await UpdateCrmSaleOrderCanInterRecon(orderId, true);

+            }

+            else if (plugin.CanInterRecon == InterReconEnums.Forbid)

+            {

+                plugin.CanInterRecon = InterReconEnums.Permit;

+                plugin.UpdateDate = DateTime.Now;

+                plugin.UserID = Define.ADMINID;

+                await UnitWork.UpdateAsync(plugin);

+                await UpdateCrmSaleOrderCanInterRecon(plugin.DocEntry, true);

+            }

+        }

+

+        private async Task AddPluginRemarkAsync(int orderId)

+        {

+            await UnitWork.AddAsync<SaleOrdrRemark, int>(new SaleOrdrRemark()

+            {

+                Remark = $"【{EnumUtility.GetDescription(InterReconEnums.Permit)}】系统自动清账",

+                DocEntry = orderId,

+                SboId = SboIdEnums.neware_201304,

+                UserID = Define.ADMINID,

+            });

         }

     

