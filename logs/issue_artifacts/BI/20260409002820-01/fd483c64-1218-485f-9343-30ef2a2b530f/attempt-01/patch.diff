+        /// <summary>

+        /// 获取RCT2数据

+        /// </summary>

+        private async Task<List<(int DocNum, int? DocEntry, decimal? SumApplied, decimal? AppliedFC)>> FetchRct2DataAsync(List<int> inv1DocEntries)

+        {

+            var indirectRct2 = await UnitWork.Find<RCT2>(re =>

+                inv1DocEntries.Contains(re.DocEntry) &&

+                re.InvType == "13")

+                .Select(re => new { re.DocNum, re.DocEntry, re.SumApplied, re.AppliedFC })

+                .ToListAsync();

+            return indirectRct2.Select(re => (re.DocNum, re.DocEntry, re.SumApplied, re.AppliedFC)).ToList();

+        }

