+        /// <summary>

+        /// 构建订单事件列表

+        /// </summary>

+        private static List<OrderEvent> BuildOrderEvents(

+            List<ReceiptForOrder> allReceipts,

+            List<HistoricalOverdueCalculationService.DeliveryForOverDue> deliveryForCalcList,

+            List<HistoricalOverdueCalculationService.ReturnForOverDue> allReturns,

+            List<SaleRefund> allRefunds,

+            List<HistoricalOverdueCalculationService.ClearReconForOverDue> allClearRecons)

+        {

+            var events = new List<OrderEvent>();

+

+            // 添加付款事件

+            foreach (var receipt in allReceipts)

+            {

+                events.Add(new OrderEvent

+                {

+                    EventDate = receipt.DocDate.Value,

+                    EventType = OrderEventType.Payment,

+                    ReferenceId = receipt.DocEntry.ToString(),

+                    Amount = receipt.AppliedAmount

+                });

+            }

+

+            // 添加交货事件

+            foreach (var delivery in deliveryForCalcList)

+            {

+                events.Add(new OrderEvent

+                {

+                    EventDate = delivery.DocDate.Value,

+                    EventType = OrderEventType.Delivery,

+                    ReferenceId = delivery.DocEntry.ToString(),

+                    Amount = delivery.DocTotal.Value

+                });

+            }

+

+            // 添加退货事件

+            foreach (var returnOrder in allReturns)

+            {

+                events.Add(new OrderEvent

+                {

+                    EventDate = returnOrder.DocDate.Value,

+                    EventType = OrderEventType.Return,

+                    ReferenceId = returnOrder.DocEntry.ToString(),

+                    Amount = returnOrder.DocTotal.Value

+                });

+            }

+

+            // 添加退款事件

+            foreach (var refund in allRefunds)

+            {

+                events.Add(new OrderEvent

+                {

+                    EventDate = refund.DocDate.Value.Date,

+                    EventType = OrderEventType.Refund,

+                    ReferenceId = refund.Id.ToString(),

+                    Amount = refund.ApplyAmount

+                });

+            }

+

+            // 添加核销事件

+            foreach (var clearRecon in allClearRecons)

+            {

+                events.Add(new OrderEvent

+                {

+                    EventDate = clearRecon.ReconDate,

+                    EventType = OrderEventType.CanClearRecon,

+                    ReferenceId = clearRecon.DocEntry.ToString(),

+                    Amount = clearRecon.ReconAmount

+                });

+            }

+

+            return events;

+        }

+

+        /// <summary>

+        /// 处理和验证事件列表

+        /// </summary>

+        private static List<OrderEvent> ProcessAndValidateEvents(

+            List<OrderEvent> events,

+            DateTime docDate)

+        {

+            // 按日期排序

+            events = events.OrderBy(e => e.EventDate).ToList();

+

+            // 过滤掉早于订单日期的付款和退款事件

+            events = events.Where(e =>

+            {

+                if (e.EventType == OrderEventType.Payment || e.EventType == OrderEventType.Refund)

+                {

+                    return e.EventDate >= docDate;

+                }

+                return true;

+            }).ToList();

+

+            return events;

+        }

