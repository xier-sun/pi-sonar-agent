+        /// <summary>

+        /// 单日处理结果

+        /// </summary>

+        private sealed class DayProcessResult

+        {

+            public PenaltyEvent CurrentEvent { get; set; }

+            public decimal PreviousOverdueAmount { get; set; }

+            public bool ShouldSaveLedgers { get; set; }

+        }

+

+        /// <summary>

+        /// 处理单日的逾期逻辑

+        /// </summary>

+        private async Task<DayProcessResult> ProcessSingleDayAsync(

+            DateTime currentDate,

+            ORDR order,

+            HistoricalOverdueCalculationService.SaleOrderForOverDue saleOrderForCalc,

+            PayTermSave payTerm,

+            List<HistoricalOverdueCalculationService.DeliveryForOverDue> deliveryList,

+            List<ReceiptForOrder> receiptList,

+            List<HistoricalOverdueCalculationService.ReturnForOverDue> returnList,

+            List<SaleRefund> refundList,

+            List<HistoricalOverdueCalculationService.ClearReconForOverDue> clearReconList,

+            SaleOrderPlugin saleOrderPlugin,

+            List<InterestRateTier> rateTiers,

+            PenaltyRuleDefinition rule,

+            OSLP slp,

+            DateTime? generationStartDate,

+            int batchSize,

+            PenaltyEvent currentEvent,

+            decimal previousOverdueAmount,

+            List<(int EventId, DateTime ResolvedDate, string Description)> pendingEventUpdates,

+            List<PenaltyLedger> penaltyLedgers)

+        {

+            var result = new DayProcessResult

+            {

+                CurrentEvent = currentEvent,

+                PreviousOverdueAmount = previousOverdueAmount

+            };

+

+            // 使用内存计算方法，不查库

+            var overdueInfo = _historicalOverdueCalculationService.CalculateHistoricalOverdueInMemory(

+                saleOrderForCalc,

+                payTerm,

+                deliveryList,

+                receiptList,

+                returnList,

+                refundList,

+                clearReconList,

+                currentDate);

+

+            // 应用调整逻辑

+            ApplyOverdueAdjustments(overdueInfo, saleOrderPlugin);

+

+            // 只有当天有逾期金额和逾期天数时才计算罚息

+            if (overdueInfo.U_Due_Amt <= 0 || overdueInfo.U_OverDue_Days <= 0)

+            {

+                // 如果当天没有逾期，但有当前事件，结束它

+                result.CurrentEvent = TryEndCurrentEvent(pendingEventUpdates, currentEvent, currentDate);

+                result.PreviousOverdueAmount = result.CurrentEvent == null ? 0 : previousOverdueAmount;

+                return result;

+            }

+

+            // 计算当天的罚息金额

+            var (penaltyAmount, dayilRate) = CalculatePenaltyAmount(overdueInfo, saleOrderPlugin, rateTiers);

+

+            if (penaltyAmount <= 0)

+            {

+                // 如果当天没有罚息，但有当前事件，结束它

+                result.CurrentEvent = TryEndCurrentEvent(pendingEventUpdates, currentEvent, currentDate);

+                result.PreviousOverdueAmount = result.CurrentEvent == null ? 0 : previousOverdueAmount;

+                return result;

+            }

+

+            // 检查逾期金额是否发生变化

+            if (overdueInfo.U_Due_Amt != previousOverdueAmount)

+            {

+                // 如果有当前事件，结束它

+                if (currentEvent != null)

+                {

+                    QueueEventUpdate(pendingEventUpdates, currentEvent, currentDate.AddDays(-1));

+                }

+

+                // 创建新的PenaltyEvent

+                result.CurrentEvent = await CreateNewPenaltyEvent(order, overdueInfo, currentDate, rule, slp);

+                result.PreviousOverdueAmount = overdueInfo.U_Due_Amt;

+                currentEvent = result.CurrentEvent;

+            }

+

+            // 创建当天的PenaltyLedger记录（仅在允许的生成日期范围内）

+            if (currentEvent != null && (!generationStartDate.HasValue || currentDate >= generationStartDate.Value))

+            {

+                CreateDailyPenaltyLedgerEntry(order, overdueInfo, penaltyAmount, currentDate, currentEvent, dayilRate, slp, ref penaltyLedgers);

+

+                // 分批保存：每累积500条记录就保存一次

+                if (penaltyLedgers.Count >= batchSize)

+                {

+                    await UnitWork.BatchAddAsync<PenaltyLedger, int>(penaltyLedgers.ToArray());

+                    await UnitWork.SaveAsync();

+                    result.ShouldSaveLedgers = true;

+                }

+            }

+

+            return result;

+        }

+

+        /// <summary>

+        /// 应用逾期调整

+        /// </summary>

+        private static void ApplyOverdueAdjustments(

+            HistoricalOverdueCalculationService.OverDueAmountAndDays overdueInfo,

+            SaleOrderPlugin saleOrderPlugin)

+        {

+            if (saleOrderPlugin == null) return;

+

+            if (saleOrderPlugin.AdjustOverdueAmount.HasValue)

+            {

+                overdueInfo.U_Due_Amt -= saleOrderPlugin.AdjustOverdueAmount.Value;

+                if (overdueInfo.U_Due_Amt < 0) overdueInfo.U_Due_Amt = 0;

+            }

+

+            if (saleOrderPlugin.AdjustOverdueDays.HasValue)

+            {

+                overdueInfo.U_OverDue_Days -= saleOrderPlugin.AdjustOverdueDays.Value;

+                if (overdueInfo.U_OverDue_Days < 0) overdueInfo.U_OverDue_Days = 0;

+            }

+        }

