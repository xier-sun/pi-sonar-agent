+        /// <summary>

+        /// 处理单个规则组

+        /// </summary>

+        private async Task ProcessRuleGroupAsync(IGrouping<string, PenaltyRuleDefinition> group, string jobRunId)

+        {

+            // 找到对应的Code

+            var processor = _allProcessors.FirstOrDefault(p => p.HandlerCode == group.Key);

+            if (processor == null) return;

+

+            // 处理器工作

+            var (newEvents, resolvedEvents, canceledEvents) = await processor.ProcessAsync(group.ToList());

+

+            // 立案

+            await ProcessNewEventsAsync(newEvents);

+

+            // 结案和取消

+            var updatePenaltyEventList = await ProcessResolvedAndCanceledEventsAsync(resolvedEvents, canceledEvents);

+            if (updatePenaltyEventList.Any())

+            {

+                await UnitWork.BatchUpdateAsync<PenaltyEvent>(updatePenaltyEventList.ToArray());

+            }

+

+            // 更新水印

+            await UpdateJobAuditAsync(group.Key);

+            await UnitWork.SaveAsync();

+

+            // 记账

+            await _ledgerService.ProcessDailyCalculations(jobRunId, group.FirstOrDefault()?.Id ?? 0);

+            // 计算并更新每个罚款事件的总罚款金额

+            await UpdateTotalPenaltyAmounts(group.FirstOrDefault()?.Id ?? 0);

+        }

