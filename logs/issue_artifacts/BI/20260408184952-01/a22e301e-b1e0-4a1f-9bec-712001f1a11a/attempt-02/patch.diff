+        /// <summary>

+        /// 处理单个订单组，生成罚息事件

+        /// </summary>

+        private PenaltyEventData ProcessOrderGroup(

+            IGrouping<int, dynamic> group,

+            ILookup<int, dynamic> delivrdProductsLookUp,

+            List<dynamic> returnItemsWithDevEntry,

+            List<dynamic> delivrdItems,

+            PenaltyRuleDefinition rule,

+            Dictionary<int?, string> slpCodeToNameMap)

+        {

+            var thisOrdrReturnItems = group.GroupBy(x => (string)x.ItemCode).Select(x => new { ItemCode = x.Key, TotalQty = x.Sum(s => (decimal)s.Quantity) }).ToDictionary(k => k.ItemCode, v => v.TotalQty);

+            var delivrdItemsInThisOrdr = delivrdProductsLookUp[(int)group.Key].GroupBy(x => (string)x.ItemCode).Select(x => new { ItemCode = x.Key, TotalQty = x.Sum(s => (decimal)s.DelivrdQty) }).ToDictionary(k => k.ItemCode, v => v.TotalQty);

+            //遍历订单中所有有价物料，检查每个物料是否都已退完

+            if (!delivrdItemsInThisOrdr.All(x => x.Value == (thisOrdrReturnItems.TryGetValue(x.Key, out decimal returnedQty) ? returnedQty : 0)))

+            {

+                return null;

+            }

+

+            // 退货单中 Price=0 的物料，按ItemCode汇总已退数量（针对当前原始订单）

+            var returnedZeroPriceQtyByItem = returnItemsWithDevEntry

+                .Where(x => x.Price == 0 && x.ResolvedDevEntry == group.Key)

+                .GroupBy(x => (string)x.ItemCode)

+                .ToDictionary(g => g.Key, g => g.Sum(s => (decimal)s.Quantity));

+            // 未退的 Price=0 物料成本 = sum(未退数量 * LastPurPrc)

+            var fixedPenaltyAmount = delivrdItems

+                .Where(x => x.Price == 0 && x.DocEntry == group.Key)

+                .GroupBy(x => (string)x.ItemCode)

+                .Sum(g =>

+                {

+                    var totalDelivrdQty = g.Sum(s => (decimal)s.DelivrdQty);

+                    returnedZeroPriceQtyByItem.TryGetValue(g.Key, out decimal returnedQty);

+                    var unreturnedQty = totalDelivrdQty - returnedQty;

+                    return unreturnedQty > 0 ? unreturnedQty * (decimal?)g.First().LastPurPrc : (decimal?)0;

+                });

+            var slpCode = delivrdItems.FirstOrDefault(x => x.Price == 0 && x.DocEntry == group.Key)?.SlpCode;

+

+            if (!fixedPenaltyAmount.HasValue || fixedPenaltyAmount == 0)

+            {

+                return null;

+            }

+

+            return new PenaltyEventData

+            {

+                RuleDefinitionId = rule.Id,

+                SlpCode = slpCode,

+                SlpName = slpCodeToNameMap[slpCode.Value],

+                TriggerDocType = "ORDR",

+                TriggerDocEntry = group.Key.ToString(),

+                SEDocEntry = (int)group.Key,

+                PenaltyBaseAmount = fixedPenaltyAmount.Value,

+                TriggerEventDate = group.OrderByDescending(x => x.CreateDate).First().CreateDate,

+                PenaltyStartDate = group.OrderByDescending(x => x.CreateDate).First().CreateDate,

+            };

         }

 

