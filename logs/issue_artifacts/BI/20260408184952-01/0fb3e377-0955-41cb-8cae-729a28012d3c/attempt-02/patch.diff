+        private async Task ProcessSingleOrderAutoPluginAsync(int orderId)

+        {

+            var ordr = await UnitWork.FindSingleAsync<ORDR>(x => x.DocEntry == orderId);

+            var ordrStat = await UnitWork.FindSingleAsync<OrdrStat>(x => x.Code == orderId.ToString());

+

+            // 已收全款，但是应收余额大于0自动可清单

+            if (ordrStat?.U_ReceivePayStatus != 1)

+                return;

+

+            // 计算人民币余额和回款率

+            var calcResult = CalculateBalanceAndPaymentRate(ordr, ordrStat);

+            if (calcResult == null || !calcResult.ShouldPlugin)

+                return;

+

+            LogHelper.Info(string.Format("自动可清单：销售单号：{0}；订单金额(人民币){1}；余额(人民币){2}；回款率{3}%",

+                orderId, calcResult.DocTotalRMB, calcResult.BalanceRMB, calcResult.PaymentRate * 100),

+                nameof(FinanceHanlerApp), nameof(AutoPluginAsync));

+

+            await ProcessPluginRecordAsync(orderId, ordrStat);

