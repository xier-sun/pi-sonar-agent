+

+        /// <summary>

+        /// 计算余额和回款率

+        /// </summary>

+        /// <param name="ordr"></param>

+        /// <param name="ordrStat"></param>

+        /// <returns></returns>

+        private static (decimal DocTotalRMB, decimal BalanceRMB, decimal PaymentRate, bool ShouldPlugin)? CalculateBalanceAndPaymentRate(ORDR ordr, OrdrStat ordrStat)

+        {

+            var docTotalRMB = ordr.DocTotal.Value;

+            if (docTotalRMB <= 0)

+                return null;

+

+            var receiptAmountRMB = ordr.U_DocRCTAmount ?? 0M;

+            var uRefundAmtRMB = ordrStat.U_Refund_Amt;

+

+            decimal balanceRMB = ordr.DocStatus == "C"

+                ? (ordrStat.U_Delivery_TotalAmt ?? 0) - (receiptAmountRMB - uRefundAmtRMB)

+                : docTotalRMB - (receiptAmountRMB - uRefundAmtRMB);

+

+            decimal paymentRate;

+

+            if (ordr.DocCur == FinanceConsts.RMB)

+            {

+                paymentRate = (receiptAmountRMB - uRefundAmtRMB) / docTotalRMB;

+                if (balanceRMB <= 0)

+                    return null;

+            }

+            else

+            {

+                var docTotalFC = ordr.DocTotalFC.Value;

+                var receiptAmountFC = ordrStat.U_Receipt_TotalAmtFC ?? 0M;

+                var uRefundAmtFC = ordrStat.U_Refund_AmtFC;

+

+                if (docTotalFC <= 0)

+                    return null;

+                if (docTotalFC - (receiptAmountFC - uRefundAmtFC) <= 0)

+                    return null;

+

+                paymentRate = (receiptAmountFC - uRefundAmtFC) / docTotalFC;

+            }

+

+            bool shouldPlugin = ordrStat.U_ReceivePayStatus == 1 ||

+                               (paymentRate >= 0.98m && Math.Abs(balanceRMB) < 100m);

+

+            return shouldPlugin ? (docTotalRMB, balanceRMB, paymentRate, true) : null;

+        }

