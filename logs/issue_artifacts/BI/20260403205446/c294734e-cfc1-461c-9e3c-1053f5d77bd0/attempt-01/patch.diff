+        /// <summary>

+        /// 创建新的社保/公积金记录

+        /// </summary>

+        private void CreateNewSocialsecurityRecord(ProcessSocialsecurityRecordParams p, DateTime now, string updateUserId)

+        {

+            // 处理旧的未指定类型的记录

+            var oldUnspecifiedTypeRecords = p.CurrentSecurities?.Where(x => x.Type != SocialsecurityTypeEnums.Socialsecurity && x.Type != SocialsecurityTypeEnums.Accumulationfunds).ToList();

+            if (oldUnspecifiedTypeRecords != null && oldUnspecifiedTypeRecords.Any())

+            {

+                p.DelSocialsecurityList.AddRange(oldUnspecifiedTypeRecords);

+                p.CurrentSecurities.RemoveAll(x => oldUnspecifiedTypeRecords.Contains(x));

+            }

+

+            // 从旧的未指定Type的记录中获取一些默认值，避免丢失

+            var defaultRecord = oldUnspecifiedTypeRecords?.FirstOrDefault();

+            var newRecord = new UserSocialsecurity

+            {

+                UserId = p.UserId,

+                Account = p.Account,

+                Name = p.Name,

+                CreateTime = now,

+                Type = p.Type,

+                Grade = defaultRecord?.Grade ?? "",

+                SocialsecurityAccount = defaultRecord?.SocialsecurityAccount ?? "",

+                Bank = defaultRecord?.Bank ?? "",

+                AttachmentId = defaultRecord?.AttachmentId,

+                SIsPay = defaultRecord?.SIsPay,

+                SIsEnd = defaultRecord?.SIsEnd,

+                PIsPay = defaultRecord?.PIsPay,

+                PIsEnd = defaultRecord?.PIsEnd,

+                ProvidentFundBank = defaultRecord?.ProvidentFundBank,

+                ProvidentFundBankAccount = defaultRecord?.ProvidentFundBankAccount,

+                SBeginPaymentTime = defaultRecord?.SBeginPaymentTime,

+                PEndPaymentTime = defaultRecord?.PEndPaymentTime,

+            };

+            ApplyInfoUpdateAuditFields(newRecord, p.OperationScene, now, updateUserId);

+            p.CreateAction(newRecord);

+            p.AddSocialsecurityList.Add(newRecord);

+        }

+

+        /// <summary>

+        /// 更新现有的社保/公积金记录

+        /// </summary>

+        private void UpdateExistingSocialsecurityRecords(ProcessSocialsecurityRecordParams p, List<UserSocialsecurity> socialsecurityRecords, DateTime now, string updateUserId)

+        {

+            foreach (var record in socialsecurityRecords)

+            {

+                p.UpdateAction(record);

+                ResetRecordStatusIfSubstantiveChange(record, p);

+                ApplyInfoUpdateAuditFields(record, p.OperationScene, now, updateUserId);

+                p.UpdateSocialsecurityList.Add(record);

+            }

+        }

+

+        /// <summary>

+        /// 当发生实质性变更时，重置记录的确认状态

+        /// </summary>

+        private void ResetRecordStatusIfSubstantiveChange(UserSocialsecurity record, ProcessSocialsecurityRecordParams p)

+        {

+            if (!p.HasSubstantiveChange)

+            {

+                return;

+            }

+

+            if (p.Type == SocialsecurityTypeEnums.Socialsecurity)

+            {

+                if (record.SIsPay == "Y")

+                {

+                    record.SIsPay = "N";

+                }

+                if (record.SIsEnd == "Y")

+                {

+                    record.SIsEnd = "N";

+                }

+            }

+            else if (p.Type == SocialsecurityTypeEnums.Accumulationfunds)

+            {

+                if (record.PIsPay == "Y")

+                {

+                    record.PIsPay = "N";

+                }

+                if (record.PIsEnd == "Y")

+                {

+                    record.PIsEnd = "N";

                 }

             }

         }
