+        /// <summary>

+        /// 更新社保字段

+        /// </summary>

+        private void UpdateSocialSecurityFields(UserSocialsecurity ss, UpdateSocialFundRequest request)

+        {

+            if (!string.IsNullOrEmpty(request.SocialSecurityAccount))

+                ss.SocialsecurityAccount = request.SocialSecurityAccount;

+            if (request.IsInternship && request.BeginPaymentTime.HasValue)

+                ss.SBeginPaymentTime = request.BeginPaymentTime;

+            if (request?.Remark != null)

+                ss.Remark = request.Remark;

+        }

+

+        /// <summary>

+        /// 判断是否需要创建社保记录

+        /// </summary>

+        private bool ShouldCreateSocialSecurity(UpdateSocialFundRequest request)

+        {

+            return !string.IsNullOrEmpty(request.SocialSecurityAccount) ||

+                   (request.IsInternship && request.BeginPaymentTime.HasValue);

+        }

+

+        /// <summary>

+        /// 创建社保字段

+        /// </summary>

+        private void CreateSocialSecurityFields(UserSocialsecurity ss, UpdateSocialFundRequest request)

+        {

+            ss.SocialsecurityAccount = request.SocialSecurityAccount ?? "";

+            ss.SBeginPaymentTime = request.IsInternship ? request.BeginPaymentTime : null;

+            ss.Remark = request.Remark ?? "";

+        }

+

+        /// <summary>

+        /// 更新公积金字段

