+        private void UpdateProvidentFundFields(UserSocialsecurity af, UpdateSocialFundRequest request)

+        {

+            if (!string.IsNullOrEmpty(request.SocialSecurityAccount))

+                af.SocialsecurityAccount = request.SocialSecurityAccount;

+            if (!string.IsNullOrEmpty(request.ProvidentFundBank))

+                af.ProvidentFundBank = request.ProvidentFundBank;

+            if (!string.IsNullOrEmpty(request.ProvidentFundBankAccount))

+                af.ProvidentFundBankAccount = request.ProvidentFundBankAccount;

+            if (request.IsInternship && request.BeginPaymentTime.HasValue)

+                af.PBeginPaymentTime = request.BeginPaymentTime;

+            if (request?.Remark != null)

+                af.Remark = request.Remark;

+        }

+

