+        /// <summary>

+        /// 处理社保缴纳预览逻辑

+        /// </summary>

+        private void ProcessSocialSecurityForPayment(

+            UpdateSocialFundRequest updateRequest,

+            List<UserSocialsecurity> previewSecurities,

+            List<UserSocialsecurity> previewAdds,

+            List<UserSocialsecurity> previewUpdates,

+            List<UserSocialsecurity> previewDeletes,

+            string systemUserId,

+            string account,

+            string userName,

+            User loginUser)

+        {

+            ProcessSocialsecurityRecord(new ProcessSocialsecurityRecordParams

+            {

+                CurrentSecurities = previewSecurities,

+                Type = SocialsecurityTypeEnums.Socialsecurity,

+                UpdateId = updateRequest.UpdateId,

+                UserId = systemUserId,

+                Account = account,

+                Name = userName,

+                UpdateAction = (ss) => {

+                    if (!string.IsNullOrEmpty(updateRequest.SocialSecurityAccount))

+                        ss.SocialsecurityAccount = updateRequest.SocialSecurityAccount;

+                    if (updateRequest.IsInternship && updateRequest.BeginPaymentTime.HasValue)

+                        ss.SBeginPaymentTime = updateRequest.BeginPaymentTime;

+                    if (updateRequest?.Remark != null)

+                        ss.Remark = updateRequest.Remark;

+                },

+                CreateCondition = () =>

+                    !string.IsNullOrEmpty(updateRequest.SocialSecurityAccount) ||

+                    (updateRequest.IsInternship && updateRequest.BeginPaymentTime.HasValue),

+                CreateAction = (ss) => {

+                    ss.SocialsecurityAccount = updateRequest.SocialSecurityAccount ?? "";

+                    ss.SBeginPaymentTime = updateRequest.IsInternship ? updateRequest.BeginPaymentTime : null;

+                    ss.Remark = updateRequest.Remark ?? "";

+                },

+                AddSocialsecurityList = previewAdds,

+                UpdateSocialsecurityList = previewUpdates,

+                DelSocialsecurityList = previewDeletes,

+                LoginUser = loginUser,

+                OperationScene = PaymentOrRefundEnums.Payment,

+                HasSubstantiveChange = false

+            });

+        }

