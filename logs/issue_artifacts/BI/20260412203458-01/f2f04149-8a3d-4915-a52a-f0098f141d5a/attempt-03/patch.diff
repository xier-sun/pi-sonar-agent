+        /// <summary>

+        /// 构建订单事件列表（收款、发货、退货、退款、计算截止）

+        /// </summary>

+        private static List<HistoricalOverdueImportService.OrderEvent> BuildOrderEvents(

+            DateTime calculationDate,

+            List<ReceiptForOrder> receipts,

+            List<HistoricalOverdueCalculationService.DeliveryForOverDue> deliveries,

+            List<HistoricalOverdueCalculationService.ReturnForOverDue> returns,

+            List<SaleRefund> refunds)

+        {

+            var events = new List<HistoricalOverdueImportService.OrderEvent>();

+

+            foreach (var receipt in receipts)

+            {

+                if (!receipt.DocDate.HasValue) continue;

+                events.Add(new HistoricalOverdueImportService.OrderEvent

+                {

+                    EventDate = receipt.DocDate.Value,

+                    EventType = HistoricalOverdueImportService.OrderEventType.Payment,

+                    ReferenceId = receipt.DocEntry.ToString(),

+                    Amount = receipt.AppliedAmount

+                });

+            }

+

+            foreach (var delivery in deliveries)

+            {

+                if (!delivery.DocDate.HasValue) continue;

+                events.Add(new HistoricalOverdueImportService.OrderEvent

+                {

+                    EventDate = delivery.DocDate.Value,

+                    EventType = HistoricalOverdueImportService.OrderEventType.Delivery,

+                    ReferenceId = delivery.DocEntry.ToString(),

+                    Amount = delivery.DocTotal ?? 0m

+                });

+            }

+

+            foreach (var returnOrder in returns)

+            {

+                if (!returnOrder.DocDate.HasValue) continue;

+                events.Add(new HistoricalOverdueImportService.OrderEvent

+                {

+                    EventDate = returnOrder.DocDate.Value,

+                    EventType = HistoricalOverdueImportService.OrderEventType.Return,

+                    ReferenceId = returnOrder.DocEntry.ToString(),

+                    Amount = returnOrder.DocTotal ?? 0m

+                });

+            }

+

+            foreach (var refund in refunds)

+            {

+                if (!refund.DocDate.HasValue) continue;

+                events.Add(new HistoricalOverdueImportService.OrderEvent

+                {

+                    EventDate = refund.DocDate.Value.Date,

+                    EventType = HistoricalOverdueImportService.OrderEventType.Refund,

+                    ReferenceId = refund.Id.ToString(),

+                    Amount = refund.ApplyAmount

+                });

+            }

+

+            events.Add(new HistoricalOverdueImportService.OrderEvent

+            {

+                EventDate = calculationDate,

+                EventType = HistoricalOverdueImportService.OrderEventType.CalculationEnd,

+                ReferenceId = "CalculationEnd",

+                Amount = 0

+            });

+

+            return events;

+        }

