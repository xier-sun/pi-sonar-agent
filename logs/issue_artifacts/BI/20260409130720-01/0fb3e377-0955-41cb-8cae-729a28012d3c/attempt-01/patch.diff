         /// <summary>

+        /// 计算人民币余额

+        /// </summary>

+        /// <param name="ordr">销售订单</param>

+        /// <param name="ordrStat">订单统计</param>

+        /// <returns>人民币余额</returns>

+        private static decimal CalculateBalanceRMB(ORDR ordr, OrdrStat ordrStat)

+        {

+            var receiptAmountRMB = ordr.U_DocRCTAmount ?? 0M;

+            var uRefundAmtRMB = ordrStat.U_Refund_Amt;

+            if (ordr.DocStatus == "C")

+            {

+                return (ordrStat.U_Delivery_TotalAmt ?? 0) - (receiptAmountRMB - uRefundAmtRMB);

+            }

+            return ordr.DocTotal.Value - (receiptAmountRMB - uRefundAmtRMB);

+        }

+

+        /// <summary>

+        /// 计算回款率

+        /// </summary>

+        /// <param name="ordr">销售订单</param>

+        /// <param name="ordrStat">订单统计</param>

+        /// <param name="balanceRMB">人民币余额（输出）</param>

+        /// <returns>回款率</returns>

+        private static decimal CalculatePaymentRate(ORDR ordr, OrdrStat ordrStat, out decimal balanceRMB)

+        {

+            balanceRMB = CalculateBalanceRMB(ordr, ordrStat);

+            if (ordr.DocCur == FinanceConsts.RMB)

+            {

+                var docTotalRMB = ordr.DocTotal.Value;

+                var receiptAmountRMB = ordr.U_DocRCTAmount ?? 0M;

+                return (receiptAmountRMB - ordrStat.U_Refund_Amt) / docTotalRMB;

+            }

+            var docTotalFC = ordr.DocTotalFC.Value;

+            var receiptAmountFC = ordrStat.U_Receipt_TotalAmtFC ?? 0M;

+            return (receiptAmountFC - ordrStat.U_Refund_AmtFC) / docTotalFC;

+        }

