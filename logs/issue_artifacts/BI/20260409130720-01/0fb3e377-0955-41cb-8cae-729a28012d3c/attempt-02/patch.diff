+        /// <summary>

+        /// 处理单个订单的可清单逻辑

+        /// </summary>

+        /// <param name="orderId">订单ID</param>

+        /// <returns></returns>

+        private async Task ProcessSingleOrderAsync(int orderId)

+        {

+            var ordr = await UnitWork.FindSingleAsync<ORDR>(x => x.DocEntry == orderId);

+            var ordrStat = await UnitWork.FindSingleAsync<OrdrStat>(x => x.Code == orderId.ToString());

+

+            // 已收全款，但是应收余额大于0自动可清单

+            if (ordrStat.U_ReceivePayStatus != 1)

+            {

+                return;

+            }

+

+            var (balanceRMB, paymentRate) = await CalculateBalanceAndPaymentRateAsync(ordr, ordrStat);

+            if (paymentRate < 0)

+            {

+                return;

+            }

+

+            if (!ShouldAllowPlugin(ordrStat, paymentRate, balanceRMB))

+            {

+                return;

+            }

+

+            await ApplyPluginAsync(orderId, ordr, balanceRMB, paymentRate);

+        }

+

+        /// <summary>

+        /// 计算余额和回款率

+        /// </summary>

+        /// <param name="ordr">订单</param>

+        /// <param name="ordrStat">订单状态</param>

+        /// <returns>(人民币余额, 回款率)</returns>

+        private async Task<(decimal balanceRMB, decimal paymentRate)> CalculateBalanceAndPaymentRateAsync(ORDR ordr, OrdrStat ordrStat)

+        {

+            // 计算人民币余额（用于100元判断）

+            var docTotalRMB = ordr.DocTotal.Value;

+            if (docTotalRMB <= 0)

+                return (0, -1);

+

+            var receiptAmountRMB = ordr.U_DocRCTAmount ?? 0M;

+            var uRefundAmtRMB = ordrStat.U_Refund_Amt;

+

+            decimal balanceRMB;

+            if (ordr.DocStatus == "C")

+            {

+                balanceRMB = (ordrStat.U_Delivery_TotalAmt ?? 0) - (receiptAmountRMB - uRefundAmtRMB);

+            }

+            else

+            {

+                balanceRMB = docTotalRMB - (receiptAmountRMB - uRefundAmtRMB);

+            }

+

+            // 计算回款率（区分人民币和外币）

+            decimal paymentRate;

+            if (ordr.DocCur == FinanceConsts.RMB)

+            {

+                paymentRate = (receiptAmountRMB - uRefundAmtRMB) / docTotalRMB;

+                if (balanceRMB <= 0)

+                    return (0, -1);

+            }

+            else

+            {

+                paymentRate = await CalculateForeignCurrencyPaymentRateAsync(ordr, ordrStat);

+                if (paymentRate < 0)

+                    return (0, -1);

+            }

+

+            return (balanceRMB, paymentRate);

+        }

+

+        /// <summary>

+        /// 计算外币回款率

+        /// </summary>

+        /// <param name="ordr">订单</param>

+        /// <param name="ordrStat">订单状态</param>

+        /// <returns>回款率，如果无效返回-1</returns>

+        private async Task<decimal> CalculateForeignCurrencyPaymentRateAsync(ORDR ordr, OrdrStat ordrStat)

+        {

+            var docTotalFC = ordr.DocTotalFC.Value;

+            var receiptAmountFC = ordrStat.U_Receipt_TotalAmtFC ?? 0M;

+            var uRefundAmtFC = ordrStat.U_Refund_AmtFC;

+

+            if (docTotalFC <= 0)

+                return -1;

+            if (docTotalFC - (receiptAmountFC - uRefundAmtFC) <= 0)

+                return -1;

+

+            return (receiptAmountFC - uRefundAmtFC) / docTotalFC;

+        }

+

+        /// <summary>

+        /// 判断是否应允许可清单

+        /// </summary>

+        /// <param name="ordrStat">订单状态</param>

+        /// <param name="paymentRate">回款率</param>

+        /// <param name="balanceRMB">人民币余额</param>

+        /// <returns>是否允许可清单</returns>

+        private static bool ShouldAllowPlugin(OrdrStat ordrStat, decimal paymentRate, decimal balanceRMB)

+        {

+            // 外币汇率差自动清账条件：

+            // 1. 已收完款（订单状态为已收全款）

+            // 2. 未收完款但总回款率达98% & 人民币余额<100元

+            return ordrStat.U_ReceivePayStatus == 1 ||

+                   (paymentRate >= 0.98m && Math.Abs(balanceRMB) < 100m);

+        }

+

+        /// <summary>

+        /// 应用可清单设置

+        /// </summary>

+        /// <param name="orderId">订单ID</param>

+        /// <param name="ordr">订单</param>

+        /// <param name="balanceRMB">人民币余额</param>

+        /// <param name="paymentRate">回款率</param>

+        /// <returns></returns>

+        private async Task ApplyPluginAsync(int orderId, ORDR ordr, decimal balanceRMB, decimal paymentRate)

+        {

+            var docTotalRMB = ordr.DocTotal.Value;

+            LogHelper.Info(string.Format("自动可清单：销售单号：{0}；订单金额(人民币){1}；余额(人民币){2}；回款率{3}%",

+                orderId, docTotalRMB, balanceRMB, paymentRate * 100), nameof(FinanceHanlerApp), nameof(AutoPluginAsync));

+

+            var plugin = await UnitWork.FindSingleAsync<SaleOrderPlugin>(r => orderId == r.DocEntry && r.SboId == SboIdEnums.neware_201304);

+            if (plugin?.CanInterRecon == InterReconEnums.Permit)

+            {

+                return;

+            }

+

+            // 设置或更新可清单标志

+            if (plugin == null)

+            {

+                await CreateNewPluginAsync(orderId);

+            }

+            else if (plugin.CanInterRecon == InterReconEnums.Forbid)

+            {

+                await UpdateExistingPluginAsync(plugin);

+            }

+

+            // 添加备注

+            await AddPluginRemarkAsync(orderId);

+            await UnitWork.SaveAsync();

+        }

+

+        /// <summary>

+        /// 创建新的可清单记录

+        /// </summary>

+        /// <param name="orderId">订单ID</param>

+        /// <returns></returns>

+        private async Task CreateNewPluginAsync(int orderId)

+        {

+            var newPlugin = new SaleOrderPlugin()

+            {

+                DocEntry = orderId,

+                SboId = SboIdEnums.neware_201304,

+                CanInterRecon = InterReconEnums.Permit,

+                UserID = Define.ADMINID,

+            };

+            await UnitWork.AddAsync<SaleOrderPlugin, int>(newPlugin);

+            await UpdateCrmSaleOrderCanInterRecon(newPlugin.DocEntry, true);

+        }

+

+        /// <summary>

+        /// 更新现有的可清单记录

+        /// </summary>

+        /// <param name="plugin">可清单记录</param>

+        /// <returns></returns>

+        private async Task UpdateExistingPluginAsync(SaleOrderPlugin plugin)

+        {

+            plugin.CanInterRecon = InterReconEnums.Permit;

+            plugin.UpdateDate = DateTime.Now;

+            plugin.UserID = Define.ADMINID;

+            await UnitWork.UpdateAsync(plugin);

+            await UpdateCrmSaleOrderCanInterRecon(plugin.DocEntry, true);

+        }

+

+        /// <summary>

+        /// 添加可清单备注

+        /// </summary>

+        /// <param name="orderId">订单ID</param>

+        /// <returns></returns>

+        private async Task AddPluginRemarkAsync(int orderId)

+        {

+            await UnitWork.AddAsync<SaleOrdrRemark, int>(new SaleOrdrRemark()

+            {

+                Remark = $"【{EnumUtility.GetDescription(InterReconEnums.Permit)}】系统自动清账",

+                DocEntry = orderId,

+                SboId = SboIdEnums.neware_201304,

+                UserID = Define.ADMINID,

+            });

         }

     

         /// <summary>
