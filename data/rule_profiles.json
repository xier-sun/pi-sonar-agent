      "risk": "low",
      "enabled": true,
      "primary_engine": "roslyn",
      "fallback_engines": ["agent", "llm"],
      "pr_mode": "auto",
      "max_changed_lines": 12,
      "complexity_level": "simple",
      "agent_config": {
        "max_turns": 5,
        "max_token_budget": 128000,
        "max_files": 1,
        "strategy_hint": "合并嵌套的 if 条件为 && 表达式，保持相同的逻辑语义。"
      }
    },
    {
      "rule_id": "csharpsquid:S1871",
      "title": "if 两个分支实现不应完全一样",
