      "primary_engine": "roslyn",
      "fallback_engines": ["agent", "llm"],
      "pr_mode": "auto",
      "max_changed_lines": 10,
      "complexity_level": "simple",
      "agent_config": {
        "max_turns": 5,
        "max_token_budget": 128000,
        "max_files": 1,
        "strategy_hint": "私有字段不涉及跨文件引用，直接移除字段声明及其无用赋值，保持最小化修改。"
      }
    },
