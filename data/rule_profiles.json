      "risk": "low",
      "enabled": true,
      "primary_engine": "roslyn",
      "fallback_engines": ["agent", "llm"],
      "pr_mode": "auto",
      "max_changed_lines": 12,
      "complexity_level": "simple",
      "agent_config": {
        "max_turns": 5,
        "max_token_budget": 128000,
        "max_files": 1,
        "strategy_hint": "合并重复分支，保留一份实现并确保控制流语义不变。"
      }
    },
    {
      "rule_id": "csharpsquid:S3260",
