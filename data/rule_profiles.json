      }
    },
    {
      "rule_id": "csharpsquid:S6960",
      "title": "Controller 不应混合职责",
      "category": "architecture",
      "risk": "high",
      "enabled": true,
      "primary_engine": "agent",
      "fallback_engines": [],
      "pr_mode": "draft",
      "max_changed_lines": 80,
      "fix_scope": "solution",
      "classification_required": true,
      "verification_policy": "strict_draft",
      "requires_solution_path": true,
      "complexity_level": "architectural",
      "agent_config": {
        "max_turns": 10,
        "max_token_budget": 256000,
        "max_files": 8,
        "allowed_operations": ["read_file", "search_in_project", "get_file_outline", "apply_edit", "create_file", "list_files", "run_build", "finish"],
        "strategy_hint": "拆分 Controller 时优先保留原路由和依赖注入行为，允许创建新 Controller 文件，但必须维持现有 HTTP 路径不变。"
      }
    },
    {
      "rule_id": "csharpsquid:S2325",
      "title": "不访问实例数据的成员应为 static",
      "category": "oop",
      "risk": "high",
      "enabled": true,
      "primary_engine": "roslyn",
      "fallback_engines": ["agent"],
      "pr_mode": "draft",
      "max_changed_lines": 8,
      "fix_scope": "file",
      "classification_required": true,
      "verification_policy": "strict_draft",
      "complexity_level": "moderate",
      "agent_config": {
        "max_turns": 6,
        "max_token_budget": 128000,
        "max_files": 1,
        "strategy_hint": "仅在确认方法完全不依赖实例状态时补 static；遇到多态、实例成员或复杂上下文时由 Agent 进一步校验。"
      }
    }
  ]
